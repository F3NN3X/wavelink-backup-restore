<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Surfaces -->
    <SolidColorBrush x:Key="WlBg"        Color="#111419" />
    <SolidColorBrush x:Key="WlChrome"    Color="#1A1E20" />
    <SolidColorBrush x:Key="WlCard"      Color="#16191A" />
    <SolidColorBrush x:Key="WlRaised"    Color="#1B1D1C" />
    <SolidColorBrush x:Key="WlSunken"    Color="#0B0D0C" />

    <!-- Text. WlMuted is the dim mono micro-labels, meta lines and section headers used across
         every dialog; #8B9096 on the dark surfaces read as low-contrast in practice, so it sits
         a step brighter than the design's first cut while staying clearly below WlText. -->
    <SolidColorBrush x:Key="WlText"      Color="#C8CBD2" />
    <SolidColorBrush x:Key="WlStrong"    Color="#FFFFFF" />
    <SolidColorBrush x:Key="WlMuted"     Color="#A6ABB3" />

    <!--
      Lines. The design's own values are rgba(200,203,210,.12) / .24 / .05 - grey-200 (WlText's
      own hue), NOT white, and the alphas are the DARK ones. These three previously carried the
      LIGHT theme's numbers (.11 / .20 / .04) over a white base, which reads as a colder, fainter
      hairline everywhere the design draws a rule: every strip edge, every pill, every card.
    -->
    <SolidColorBrush x:Key="WlLine"      Color="#C8CBD2" Opacity="0.12" />
    <SolidColorBrush x:Key="WlLine2"     Color="#C8CBD2" Opacity="0.24" />
    <SolidColorBrush x:Key="WlHover"     Color="#C8CBD2" Opacity="0.05" />
    <!-- High contrast's hover outline (the high-contrast spec: "Hover = 1px HotTrack outline, no
         fill"). WlHover goes transparent there, so hover needs its own key. Here it is unused -
         Dark/Light hover is still WlHover's fill - but the guard that all three theme
         dictionaries share one key set requires it defined everywhere. -->
    <SolidColorBrush x:Key="WlHotTrack"  Color="#4A9EFF" />

    <!-- Accent. WlAccent follows the OS accent (plan 3); WlDanger never does. -->
    <SolidColorBrush x:Key="WlAccent"     Color="#F01616" />
    <SolidColorBrush x:Key="WlAccentInk"  Color="#FFFFFF" />
    <SolidColorBrush x:Key="WlAccentSoft" Color="#F01616" Opacity="0.12" />
    <SolidColorBrush x:Key="WlAccentLine" Color="#F01616" Opacity="0.32" />
    <SolidColorBrush x:Key="WlDanger"     Color="#F01616" />
    <!-- The Failed strip's fill. WlAccentSoft is the same red at 12% - a tint, not the full
         accent, so the strip reads as a state rather than a button. -->
    <SolidColorBrush x:Key="WlDangerSoft" Color="#F01616" Opacity="0.12" />

    <!--
      Health. Dark's warn tint is .13, not the .18 the LIGHT theme uses - amber-400 at 18% over
      #111419 is a much heavier band than the design draws, and it is the tint that fills a whole
      suspect row.
    -->
    <SolidColorBrush x:Key="WlOk"        Color="#5FD3A6" />
    <SolidColorBrush x:Key="WlOkSoft"    Color="#5FD3A6" Opacity="0.14" />
    <SolidColorBrush x:Key="WlWarn"      Color="#F5B843" />
    <SolidColorBrush x:Key="WlWarnSoft"  Color="#F5B843" Opacity="0.13" />

    <!--
      rgba(4,6,6,.55). The light theme's scrim is a barely-there .22 because it dims a bright
      window; dark's is more than twice that, and it is what makes a modal read as modal rather
      than as a panel floating on a fully-lit list.
    -->
    <SolidColorBrush x:Key="WlScrim"     Color="#040606" Opacity="0.55" />

    <!-- The caption row's own material, when Mica does not take: MainWindow paints this instead. -->
    <SolidColorBrush x:Key="WlTransparent" Color="Transparent" />

    <!-- The close caption button's hover fill. WlDanger's own colour here; Highlight in
         high contrast, because WlDanger itself is not (see HighContrast.xaml). -->
    <SolidColorBrush x:Key="WlCaptionCloseHover" Color="#F01616" />

</ResourceDictionary>
