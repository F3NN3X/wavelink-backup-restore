<Application x:Class="WaveLinkBackup.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Slot 0. Replaced at runtime by ThemeManager.Apply. -->
                <ResourceDictionary Source="Theming/Dark.xaml" />
                <!-- Type scale and embedded font families. -->
                <ResourceDictionary Source="Views/Typography.xaml" />
                <!-- Screen 1's row: the six-column grid, the health strip, the pills and the tier
                     badges (Task 10a), including WlColumnHeaderTrackedText - shared with 10b's
                     column header below. Merged before ControlStyles.xaml because
                     WlColumnHeaderRowTemplate (ControlStyles.xaml) references that style by
                     StaticResource inside a DataTemplate: a StaticResource cannot resolve forward
                     across merge order, only back to a dictionary already merged before it, so the
                     definition has to come first even though the reference is only ever hit lazily,
                     at template instantiation. It self-merges Typography.xaml, so its own internal
                     StaticResources do not depend on this ordering either. -->
                <ResourceDictionary Source="Views/RowStyles.xaml" />
                <!-- The caption row's own styles and geometry, plus WlColumnHeaderRowTemplate -
                     after Typography so anything in here that wants WlDisplayFont or WlMonoFont
                     can find it, and after RowStyles.xaml so WlColumnHeaderRowTemplate's own
                     StaticResource="{StaticResource WlColumnHeaderTrackedText}" (defined in
                     RowStyles.xaml) can resolve. -->
                <ResourceDictionary Source="Views/ControlStyles.xaml" />
                <!--
                  Views/TrayIcon.xaml is deliberately NOT merged here. The tray menu is loaded
                  fresh, by pack URI, every time the theme changes - a detached ContextMenu never
                  sees a resource swap, so a single shared instance would keep whichever theme was
                  current when the app started. See App.RebuildTrayMenu.
                -->
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
