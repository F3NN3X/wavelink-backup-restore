<Window x:Class="WaveLinkBackup.App.Views.ErrorDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="Error"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <!--
      The three decision dialogs (the errors spec "Dialogs"): error 2 (two installations, chooser),
      error 4 (malformed settings, amber) and error 8 (newer version). Same borderless-modal shape
      as DeleteDialog: WlScrim fills this window edge to edge and a centred WlCard card sits on top.

      The DataContext is an ErrorDialogModel set by the caller; every element binds to it and
      computes nothing. Nothing here touches Core or does I/O - rendering only.

      Card width is bound (620 for the chooser, 560 for the other two). The note block, the
      chooser list, the "remember this one" checkbox and the ghost footer action all collapse to
      zero when their bound value is null/empty, so each variant renders only what it needs.

      Weight: error 4 is amber (the live settings file is not whole); errors 2 and 8 are neutral.
      The note block's fill switches on the model's Weight via a trigger - amber uses WlWarnSoft,
      neutral uses WlSunken. No colour is painted for the chooser or the version readout.
    
      WindowStartupLocation is Manual, not CenterOwner: DialogOverlay positions this window over
      its owner on SourceInitialized, and CenterOwner would re-centre a full-owner-sized overlay
      afterwards, pushing it off by half the owner.
    -->
    <Window.Resources>
        <!-- The RUNNING chip and the meta line each hide themselves on a false. One converter,
             two uses: both answer the same question about the same row. -->
        <views:BoolToVisibilityConverter x:Key="RunningChipVisible" />
    </Window.Resources>

    <Grid>
        <!-- The scrim: what dims the app behind. Fills the overlay edge to edge, and the overlay
             spans the owner (DialogOverlay.Cover), so this reaches the app's own edges. -->
        <Border Background="{DynamicResource WlScrim}" />

        <!-- The card: width bound (620/560), WlCard surface, hairline-24% border, 8px radius. -->
        <Border Width="{Binding CardWidth}" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                Effect="{StaticResource WlDialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- content -->
                    <RowDefinition Height="Auto" /> <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Content: 26px left/right, 26 top / 24 bottom, 18px between blocks. -->
                <StackPanel Grid.Row="0" Margin="26,26,26,24">

                    <!-- 1. Title: dialog title role, Rubik 500 20px/1.3. -->
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WlDialogTitleText}"
                               Foreground="{DynamicResource WlStrong}"
                               AutomationProperties.Name="Error title" />

                    <!-- 2. Body: Rubik 400 14px/1.55, 18px below the title. -->
                    <TextBlock Text="{Binding Body}" Style="{StaticResource WlBodyText}"
                               Foreground="{DynamicResource WlText}" Margin="0,18,0,0" />

                    <!--
                      3a. Error 2 chooser: one bordered row per installation, each with a radio.
                      Collapses to zero height when Options is empty (errors 4 and 8 have none).
                      The Border.Tag carries the nullable/empty binding; the trigger collapses on it.
                    -->
                    <ItemsControl x:Name="ChooserList" ItemsSource="{Binding Options}" Margin="0,18,0,0">
                        <ItemsControl.Style>
                            <Style TargetType="ItemsControl">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ItemsControl.Style>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--
                                  06 §2's full row: version (Rubik 500 14px), a RUNNING chip where
                                  applicable, the ellipsised path, and the SETTINGS SAVED … meta
                                  line - with the selected row taking a WlBg fill and a 3px accent
                                  left edge.

                                  It was a bare radio and a path until 0.6.1, which makes "pick the
                                  one you actually use" a decision by file path alone - the exact
                                  thing this dialog exists to make easier (technical-debt.md §4.21
                                  item 7).
                                -->
                                <Border Margin="0,0,0,9" CornerRadius="8" Padding="13,12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource WlSunken}" />
                                            <Setter Property="BorderBrush" Value="{DynamicResource WlLine}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource WlBg}" />
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WlAccent}" />
                                                    <Setter Property="BorderThickness" Value="3,1,1,1" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" /> <!-- radio -->
                                            <ColumnDefinition Width="*" />    <!-- the three lines -->
                                        </Grid.ColumnDefinitions>

                                        <!-- The radio: the user picks exactly one. -->
                                        <RadioButton x:Name="InstallRadio" Grid.Column="0"
                                                     VerticalAlignment="Center" Margin="0,0,12,0"
                                                     IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                     GroupName="WhichInstall"
                                                     AutomationProperties.Name="{Binding Title}" />

                                        <StackPanel Grid.Column="1">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Title}"
                                                           Style="{StaticResource WlBodyText}"
                                                           FontSize="14" FontWeight="Medium"
                                                           Foreground="{DynamicResource WlStrong}"
                                                           VerticalAlignment="Center"
                                                           AutomationProperties.Name="Installation version" />

                                                <!-- The RUNNING chip. An approximation, and the
                                                     model says so: Windows offers no mapping from
                                                     a running MSIX process back to its package. -->
                                                <Border Margin="9,0,0,0" CornerRadius="4"
                                                        Padding="6,2" VerticalAlignment="Center"
                                                        Background="{DynamicResource WlOkSoft}"
                                                        Visibility="{Binding IsRunning, Converter={StaticResource RunningChipVisible}}">
                                                    <TextBlock Text="RUNNING"
                                                               FontFamily="{DynamicResource WlMonoFont}"
                                                               FontSize="10" FontWeight="Medium"
                                                               Foreground="{DynamicResource WlOk}"
                                                               AutomationProperties.Name="Wave Link is running from this installation" />
                                                </Border>
                                            </StackPanel>

                                            <!-- The path: mono, ellipsised - it is long, and it
                                                 must not push the row wider than the card. -->
                                            <TextBlock Text="{Binding Path}"
                                                       Style="{StaticResource WlMonoMetaText}"
                                                       Foreground="{DynamicResource WlText}"
                                                       Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Path}"
                                                       AutomationProperties.Name="Installation path" />

                                            <TextBlock Text="{Binding Meta}"
                                                       Style="{StaticResource WlMonoMetaText}"
                                                       Foreground="{DynamicResource WlMuted}"
                                                       Margin="0,3,0,0"
                                                       Visibility="{Binding HasMeta, Converter={StaticResource RunningChipVisible}}"
                                                       AutomationProperties.Name="What this installation holds" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!--
                      3b. Note block (errors 4 and 8): a bordered block under the body. Error 4 is
                      amber (WlWarnSoft) - the live configuration is not whole; error 8 is neutral
                      (WlSunken). Collapses to zero height when Note is null (error 2 has no block).
                      The first line is Rubik body (error 4's note) or mono (error 8's "MADE WITH");
                      the optional second line is always mono - a parse detail or the "YOU HAVE" version.
                    -->
                    <!--
                      The fill/edge are set in the code-behind from the model's Weight (amber for
                      error 4, neutral otherwise) - NOT by a DataTrigger. A style-trigger that swaps
                      brushes is unreliable when the window is shown off-screen without a full render
                      pass (the trigger never fires, leaving both brushes at their local value), and
                      it would make the amber variant untestable. Setting them explicitly in the
                      constructor is deterministic: the decision lives where the model's weight lives,
                      and a test can assert the resulting brushes directly. The neutral defaults below
                      are what error 8 (and any future neutral note) gets; error 4 overrides both.
                    -->
                    <Border x:Name="NoteBlock" Margin="0,18,0,0" CornerRadius="8" Padding="14,13"
                            Background="{DynamicResource WlSunken}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                            AutomationProperties.Name="Error note">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Tag>
                            <Binding Path="Note" />
                        </Border.Tag>
                        <StackPanel>
                            <!-- First line: Rubik body for error 4's note; the model stores it as Body. -->
                            <TextBlock Text="{Binding Note.Body}"
                                       FontFamily="{DynamicResource WlDisplayFont}"
                                       FontSize="12.5" LineHeight="18.75" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WlText}" />
                            <!-- Optional second line: mono, muted - a parse detail or the version readout. -->
                            <TextBlock Text="{Binding Note.SecondLine}"
                                       Foreground="{DynamicResource WlMuted}" Margin="0,9,0,0">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WlMonoMetaText}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <Trigger Property="Tag" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <TextBlock.Tag>
                                    <Binding Path="Note.SecondLine" />
                                </TextBlock.Tag>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Footer: WlBg, hairline top, 18px vertical / 26px horizontal. -->
                <Border Grid.Row="1" Background="{DynamicResource WlBg}"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                        Padding="26,18">
                    <Grid>
                        <!--
                          Error 2's "Remember this one and stop asking": a checkbox pinned left of the
                          button pair (06 §2). Collapses to zero width when RememberLabel is null -
                          errors 4 and 8 have no such control.
                        -->
                        <CheckBox x:Name="RememberCheckbox" Content="{Binding RememberLabel}"
                                  HorizontalAlignment="Left" VerticalAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                            <CheckBox.Tag>
                                <Binding Path="RememberLabel" />
                            </CheckBox.Tag>
                        </CheckBox>

                        <!-- Ghost footer action (error 4 "Open the folder"): pinned left, right of the checkbox. -->
                        <Button x:Name="GhostButton" Content="{Binding GhostLabel}"
                                HorizontalAlignment="Left" Margin="16,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource WlGhostButton}">
                                    <Setter Property="Visibility" Value="Visible" />
                                    <Style.Triggers>
                                        <Trigger Property="Tag" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                            <Button.Tag>
                                <Binding Path="GhostLabel" />
                            </Button.Tag>
                        </Button>

                        <!-- Secondary + primary, right-aligned. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <!-- Secondary (Cancel / Close): focus starts here; Escape is equivalent to it. -->
                            <Button x:Name="SecondaryButton" Content="{Binding SecondaryLabel}" IsDefault="False"
                                    Style="{StaticResource WlSecondaryButton}"
                                    AutomationProperties.Name="Secondary action" />

                            <!-- Primary (Use this one / Try again / Get the update): the affirmative action. -->
                            <Button x:Name="PrimaryButton" Content="{Binding PrimaryLabel}" IsDefault="True"
                                    Margin="9,0,0,0" Style="{StaticResource WlPrimaryButton}"
                                    AutomationProperties.Name="Primary action" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
