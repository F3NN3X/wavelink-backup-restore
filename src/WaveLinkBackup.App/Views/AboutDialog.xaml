<Window x:Class="WaveLinkBackup.App.Views.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="About Wave Link Backup"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Maps the model's nullable URL strings to a Uri for NavigateUri. A Hyperlink without a
             NavigateUri never fires RequestNavigate, so the footer links bind this; null or an
             unparseable value leaves it unset (see StringToUriConverter). -->
        <views:StringToUriConverter x:Key="LinkUri" />
    </Window.Resources>

    <!--
      The about dialog: the same borderless-modal shape as HelpDialog and DeleteDialog - WlScrim
      fills this window edge to edge and a 420px WlCard card sits centred on top of it. Everything
      else follows their rules too: WindowStyle=None because a dialog has no caption to host,
      AllowsTransparency TRUE so the scrim really dims the app, WindowStartupLocation Manual because
      DialogOverlay positions the window over its owner on SourceInitialized.

      The DataContext is an AboutDialogModel set by the caller (App.OpenAbout builds it fresh each
      time - the version and links are read from the assembly and environment at construction);
      every element below binds to it and computes nothing. Nothing here touches Core or does I/O
      except the two browser launches the footer links perform.
    -->
    <Grid>
        <!-- The scrim: what dims the app behind. Fills the overlay edge to edge, and the overlay
             spans the owner (DialogOverlay.Cover), so this reaches the app's own edges. -->
        <Border Background="{DynamicResource WlScrim}" />

        <!-- The card: 420px, WlCard surface, hairline-24% border (WlLine2), 8px radius. Narrower
             than HelpDialog's 560 because the content is a few short lines, not prose. -->
        <Border x:Name="AboutCard" Width="420" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                Effect="{StaticResource WlDialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- content -->
                    <RowDefinition Height="Auto" /> <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Content: 26px left/right, 26 top / 24 bottom (WPF Thickness "26,26,26,24").
                     The app name and version share one line - the name in the dialog-title role,
                     the version in mono muted beside it, the same pairing the tray readout makes. -->
                <StackPanel Grid.Row="0" Margin="26,26,26,24">

                    <!-- 1. Name + version: one line, baseline-aligned. -->
                    <Grid>
                        <TextBlock Text="{Binding AppName}" Style="{StaticResource WlDialogTitleText}"
                                   Foreground="{DynamicResource WlStrong}" VerticalAlignment="Bottom"
                                   AutomationProperties.Name="Application name" />
                        <TextBlock Text="{Binding Version}" Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom" Margin="0,0,0,1"
                                   AutomationProperties.Name="Version" />
                    </Grid>

                    <!-- 2. Description: Rubik 400 14px/1.55, 14px below the name line. -->
                    <TextBlock Text="{Binding Description}" Style="{StaticResource WlBodyText}"
                               Foreground="{DynamicResource WlText}" Margin="0,14,0,0" />

                    <!-- 3. The not-affiliated line: the README's own sentence, mono muted, 14px
                         below the description. It is legal copy, not decoration - pinning it in a
                         test keeps a copy edit from dropping it without notice. -->
                    <TextBlock Text="{Binding AffiliationLine}" Style="{StaticResource WlMonoMetaText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,14,0,0"
                               AutomationProperties.Name="Affiliation" />

                    <!-- 4. Licence: mono muted, 8px below the affiliation line. -->
                    <TextBlock Text="{Binding LicenceLine}" Style="{StaticResource WlMonoMetaText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0"
                               AutomationProperties.Name="Licence" />
                </StackPanel>

                <!-- Footer: WlBg, hairline top, 18px vertical / 26px horizontal - the same footer
                     shape as HelpDialog's. The two links sit left; OK sits right and is the button
                     Escape and Enter both reach. -->
                <Border Grid.Row="1" Background="{DynamicResource WlBg}"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                        Padding="26,18">
                    <Grid>
                        <!-- The links: inline text, 18px apart. A null URL (none configured)
                             collapses the whole block to zero width via the code-behind's Loaded
                             handler - a link that points nowhere is worse than no link (the same
                             rule as App.ReleaseSource's IsConfigured). Collapsing in code rather
                             than the XAML keeps the model free of WPF types. -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                            <TextBlock x:Name="ReleasesLink" Foreground="{DynamicResource WlAccent}"
                                       FontFamily="{DynamicResource WlDisplayFont}" FontSize="13"
                                       Cursor="Hand"
                                       AutomationProperties.Name="Open the releases page">
                                <Hyperlink x:Name="ReleasesHyperlink"
                                           NavigateUri="{Binding ReleasesUrl, Converter={StaticResource LinkUri}}"
                                           AutomationProperties.Name="Open the releases page in a browser">
                                    <Run Text="{Binding ReleasesLabel, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>

                            <TextBlock x:Name="RepositoryLink" Margin="18,0,0,0"
                                       Foreground="{DynamicResource WlAccent}"
                                       FontFamily="{DynamicResource WlDisplayFont}" FontSize="13"
                                       Cursor="Hand"
                                       AutomationProperties.Name="Open the source code">
                                <Hyperlink x:Name="RepositoryHyperlink"
                                           NavigateUri="{Binding RepositoryUrl, Converter={StaticResource LinkUri}}"
                                           AutomationProperties.Name="Open the source code in a browser">
                                    <Run Text="{Binding RepositoryLabel, Mode=OneWay}" />
                                </Hyperlink>
                            </TextBlock>
                        </StackPanel>

                        <!-- OK: secondary, with no access key - the same reason as HelpDialog's Close
                             button: one button in the footer, nothing to disambiguate between. Focus
                             starts here and Escape is equivalent to it, so dismissing needs no handler
                             beyond IsCancel on the button itself. -->
                        <Button x:Name="OkButton" Content="OK" HorizontalAlignment="Right"
                                IsCancel="True" Style="{StaticResource WlSecondaryButton}"
                                AutomationProperties.Name="Close about dialog" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
