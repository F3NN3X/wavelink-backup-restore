<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Merged HERE rather than alongside this file in App.xaml. A StaticResource inside a
      ResourceDictionary resolves against that dictionary and its own MergedDictionaries - NOT
      against sibling dictionaries merged into the same parent - so the styles have to be reachable
      from in here or every Style reference below fails at parse time.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="TrayMenuStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <ContextMenu x:Key="TrayMenu" Style="{StaticResource WlTrayMenu}">
        <ContextMenu.Resources>
            <Style TargetType="MenuItem" BasedOn="{StaticResource WlTrayMenuItem}" />
            <Style TargetType="Separator" BasedOn="{StaticResource WlTrayMenuSeparator}" />
        </ContextMenu.Resources>

        <!-- A readout, not an item. Its Header is rewritten on every tray refresh. -->
        <MenuItem x:Name="LastBackupHeader" Header="LAST BACKUP"
                  Style="{StaticResource WlTrayMenuReadout}" IsEnabled="False" />
        <Separator />
        <MenuItem x:Name="BackUpNow" Header="Back up now"
                  Style="{StaticResource WlTrayMenuDefaultItem}" />
        <MenuItem x:Name="OpenApp" Header="Open Wave Link Backup" />
        <MenuItem x:Name="OpenFolder" Header="Open the backup folder" />
        <Separator />
        <MenuItem x:Name="AutoBackup" Header="Back up automatically" IsCheckable="True" />
        <MenuItem x:Name="PauseResume" Header="Pause for an hour" />
        <Separator />
        <MenuItem x:Name="OpenSettings" Header="Settings…" />
        <!-- Quitting stops the backups, and the item says so rather than a dialog afterwards. -->
        <MenuItem x:Name="Quit" Header="Quit — stops backing up" />
    </ContextMenu>

</ResourceDictionary>
