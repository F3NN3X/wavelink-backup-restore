<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WaveLinkBackup.App.Views">

    <!--
      README's dialog shadow, verbatim: "0 30px 70px rgba(0,0,0,.5)".

      Drawn by the card rather than by DWM. Every dialog is now a LAYERED window (see
      DialogOverlay), and a layered window gets no system shadow - which is the better trade, since
      the system shadow never matched this value and the design states it exactly. Black is a named
      colour, not a hex literal, so it stays legal outside Theming/ under the colour-literal guard;
      a shadow is not a theme role - it is the absence of light, and it is black in both themes.
    -->
    <DropShadowEffect x:Key="WlDialogShadow" Color="Black" Opacity="0.5"
                      BlurRadius="70" ShadowDepth="30" Direction="270" />

    <!--
      The window's shield-check mark. Same 24px-grid Lucide idiom TrayIconRenderer already draws
      for the tray icon - copied here as path data rather than drawn a second way. Technical-debt
      §4.7 names TrayIconRenderer as the substitution point once a real icon set exists; this
      caption glyph is the same substitution point.
    -->
    <Geometry x:Key="WlShieldCheckGeometry">M12 2 L20 5 V11 C20 16 16.5 19.5 12 21 C7.5 19.5 4 16 4 11 V5 Z M8.5 12 L11 14.5 L15.5 9.5</Geometry>

    <!--
      The three caption buttons: 46x34, which is Windows' own caption hit target. No border and
      no FocusVisualStyle of its own - the caption row is not where this app's first focus ring
      belongs, and one arrives later on a shared style. WlHover is the same 4% lift used
      everywhere else a surface needs to say "you are over me" without becoming a coloured band.
    -->
    <Style x:Key="WlCaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="Segoe Fluent Icons" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="HoverLayer" Background="{DynamicResource WlHover}" Opacity="0" />
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Close differs from Minimise/Maximise: it fills WlDanger on hover in Dark and Light, matching
      every other window on Windows. High contrast cannot reuse WlDanger for that - HighContrast
      .xaml deliberately maps WlDanger to WindowText, because 11-high-contrast.md says nothing in
      high contrast is red - so the hover goes through WlCaptionCloseHover instead: WlDanger's own
      colour in Dark and Light, Highlight in high contrast. That is what keeps this a DynamicResource
      swap, live on an HC toggle, rather than a trigger that has to ask SystemParameters itself.
      The glyph uses WlAccentInk, which already resolves to HighlightText in high contrast.
    -->
    <Style x:Key="WlCaptionCloseButton" TargetType="Button" BasedOn="{StaticResource WlCaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- The red fill is its own layer so it can FADE. Painting it onto Surface
                             would mean animating a frozen resource brush, which throws. -->
                        <Border x:Name="CloseLayer" Background="{DynamicResource WlCaptionCloseHover}"
                                Opacity="0" />
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <!-- The glyph colour is a discrete swap, not a fade: it has two legible
                                 states and nothing readable in between. -->
                            <Setter Property="Foreground" Value="{DynamicResource WlAccentInk}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CloseLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="CloseLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      10b: the search, settings and bottom-bar icons. Same 24px-grid Lucide idiom as the
      caption's WlShieldCheckGeometry above and RowStyles.xaml's own three glyphs - a separate
      copy in a separate dictionary, not a rename, since RowStyles.xaml is merged standalone by
      pack URI in Task 12 and must not depend on this file being merged too. All six are
      stroke-rendered (Stroke + StrokeThickness on the Path that uses them, no Fill) - simpler to
      author as open paths than to get a fill region right, and nothing here is pixel-tested (the
      guard tests only check that the KEY exists, same rule RowStyles.xaml's own comment states
      for its three glyphs).
    -->
    <Geometry x:Key="WlSearchGeometry">M10 4 A6 6 0 1 0 10 16 A6 6 0 1 0 10 4 Z M14.5 14.5 L20.5 20.5</Geometry>
    <Geometry x:Key="WlGearGeometry">M9 12 A3 3 0 1 0 15 12 A3 3 0 1 0 9 12 Z M12 2 L12 5 M12 19 L12 22 M2 12 L5 12 M19 12 L22 12 M4.9 4.9 L7.05 7.05 M16.95 16.95 L19.1 19.1 M19.1 4.9 L16.95 7.05 M7.05 16.95 L4.9 19.1</Geometry>
    <Geometry x:Key="WlCloseGeometry">M5 5 L15 15 M15 5 L5 15</Geometry>
    <Geometry x:Key="WlPencilGeometry">M4 20 L4 16 L15 5 L19 9 L8 20 Z M13 7 L17 11</Geometry>
    <Geometry x:Key="WlTrashGeometry">M5 7 L19 7 M9 7 L9 4 L15 4 L15 7 M7 7 L7.6 20 L16.4 20 L17 7 M10 11 L10 16 M14 11 L14 16</Geometry>
    <Geometry x:Key="WlRotateCcwGeometry">M4 4 L4 9 L9 9 M4.6 15 A8 8 0 1 0 6.2 6.2</Geometry>
    <Geometry x:Key="WlDownloadTrayGeometry">M12 3 L12 14 M7 9 L12 14 L17 9 M4 18 L4 20 L20 20 L20 18</Geometry>
    <Geometry x:Key="WlFolderGeometry">M3 6 A1.5 1.5 0 0 1 4.5 4.5 H9 L11 7 H19.5 A1.5 1.5 0 0 1 21 8.5 V17 A1.5 1.5 0 0 1 19.5 18.5 H4.5 A1.5 1.5 0 0 1 3 17 Z</Geometry>

    <!--
      Reused three times verbatim (row 2's real column header, and the Empty/FolderMissing
      stand-ins that render their own copy of it per the brief's Step 4) - a DataTemplate rather
      than three hand-copied Grids, since a DataTemplate can be instantiated more than once where
      a plain element cannot. The six SharedSizeGroup names MUST match WlRowTemplate's own
      (RowStyles.xaml) for the header to line up with every row - MainWindow.xaml sets
      Grid.IsSharedSizeScope="True" on its OWN root Grid (not here) because that is the nearest
      element that is a common ancestor of THIS header and the row template nested three layers
      deep inside the list; setting it on either alone would not reach the other.
    -->
    <DataTemplate x:Key="WlColumnHeaderRowTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="200" SharedSizeGroup="WlColName" />
                <ColumnDefinition Width="120" SharedSizeGroup="WlColTaken" />
                <ColumnDefinition Width="124" SharedSizeGroup="WlColWhy" />
                <ColumnDefinition Width="300" SharedSizeGroup="WlColInputs" />
                <ColumnDefinition Width="200" SharedSizeGroup="WlColContents" />
                <ColumnDefinition Width="40" SharedSizeGroup="WlColOverflow" />
            </Grid.ColumnDefinitions>

            <views:TrackedText Grid.Column="0" Text="NAME" Tracking=".18" Margin="0,0,20,0"
                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center" />
            <views:TrackedText Grid.Column="1" Text="TAKEN" Tracking=".18" Margin="0,0,20,0"
                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center" />
            <!-- WHY/INPUTS get a spelt-out AutomationProperties.Name (Step 5): short all-caps mono
                 labels are exactly what a reader spells out letter-by-letter rather than reads as
                 a word. TrackedText's own AutomationPeer defers to this explicit override. -->
            <views:TrackedText Grid.Column="2" Text="WHY" Tracking=".18" Margin="0,0,20,0"
                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center"
                                AutomationProperties.Name="Why" />
            <views:TrackedText Grid.Column="3" Text="INPUTS" Tracking=".18" Margin="0,0,20,0"
                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center"
                                AutomationProperties.Name="Inputs" />
            <views:TrackedText Grid.Column="4" Text="CONTENTS" Tracking=".18" Margin="0,0,20,0"
                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center" />
        </Grid>
    </DataTemplate>

    <!--
      Ghost: transparent, lifts WlHover on hover, 40% when disabled. Rename, Delete and the
      settings gear all want this "quiet until touched" treatment. Restore/Back up now do NOT use
      it plain - see WlSecondaryButton/WlPrimaryButton below, which need their own idle-state
      chrome (a border, a fill) that a pure ghost has none of.
    -->
    <Style x:Key="WlGhostButton" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <!-- README's type table: "Button | Rubik 500 (primary) or 400 (secondary/ghost), 13.5px".
             Ghost and secondary keep weight 400 and inherit this size; WlPrimaryButton and
             WlDangerButton step up to Medium below. 12.5px is the SECONDARY/description role and
             was reaching every button label in the app, which is why they read a size small. -->
        <Setter Property="FontFamily" Value="{DynamicResource WlDisplayFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- The hover fill is a LAYER, not a Background swap: WlHover is a frozen
                             theme resource and animating a frozen brush's Color throws. Fading a
                             layer instead also means a live theme swap needs no special case. -->
                        <Border x:Name="HoverLayer" Background="{DynamicResource WlHover}"
                                CornerRadius="8" Opacity="0" />
                        <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!--
                          11-high-contrast.md: "Hover = 1px HotTrack outline, no fill." WlHover
                          resolves to Transparent in high contrast (HighContrast.xaml), so without
                          this a hovered button gives no feedback at all there. IsMouseOver is
                          expressed as a Binding (RelativeSource Self) rather than a plain Trigger
                          Property, because it has to sit in a MultiDataTrigger alongside the
                          IsHighContrast binding - the same reach WlFocusVisual and WlRowTemplate's
                          own selected+HC triggers already use for exactly this reason.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                        </MultiDataTrigger>

                        <!--
                          11-high-contrast.md: "40% opacity is illegal here - transparency is not a
                          contrast guarantee. Disabled = GrayText for border and label at full
                          opacity, even though HC Black makes that bright green. Do not override it."
                          Declared after the plain IsEnabled=False trigger so it wins and restores
                          Opacity to 1; Foreground here targets the Button itself (no TargetName),
                          which is what carries through to the label TextBlock (Foreground is an
                          inherited property) and to any icon Path bound to
                          RelativeSource AncestorType=Button, Path=Foreground.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The 36x36 icon-only ghost square - the caption bar's own idiom (WlCaptionButton above),
         reused for the status strip's settings gear. -->
    <Style x:Key="WlIconGhostButton" TargetType="Button" BasedOn="{StaticResource WlGhostButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
      Restore this backup: a hairline border rather than a fill - "secondary" per the bottom bar's
      measurement table ("secondary, hairline-24% border"). WlLine2 stands in for that hairline
      rather than a new opacity key: it is already the closest existing token, and the brief says
      to prefer not needing a new one.
    -->
    <Style x:Key="WlSecondaryButton" TargetType="Button" BasedOn="{StaticResource WlGhostButton}">
        <Setter Property="Padding" Value="12,7" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- See WlGhostButton's own comment on why the hover is a layer. -->
                        <Border x:Name="HoverLayer" Background="{DynamicResource WlHover}"
                                CornerRadius="8" Opacity="0" />
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                                Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!-- See WlGhostButton's own comment on this trigger pair. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Back up now: the one primary, filled action - WlAccent per the bottom bar's own measurement
      table. Hover dips the surface's opacity slightly rather than reaching for a second accent
      shade, which would need a new theme key for exactly one button.
    -->
    <Style x:Key="WlPrimaryButton" TargetType="Button" BasedOn="{StaticResource WlGhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource WlAccentInk}" />
        <!-- "Rubik 500 (primary)" - the one weight step that separates the filled action from the
             three quiet ones beside it in the bottom bar. -->
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{DynamicResource WlAccent}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- No hover LAYER here: this surface is an opaque fill, so a layer behind
                             it would never show. The dip is animated on the fill's own Opacity. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.88" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!-- See WlGhostButton's own comment on this trigger pair. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Restore this backup: the app's single destructive action. WlDanger per the token table - and,
      unlike WlPrimaryButton above, it NEVER follows the user accent: the danger brush is a fixed red in
      every theme precisely because a destructive button that changes
      colour with the OS accent would stop reading as "this one is irreversible". Same hover dip as
      the primary rather than a second danger shade - there is no WlDangerHover key and none is
      needed for one button. The rotate-ccw glyph sits in the content, not here: this style only
      owns the surface, so the icon's colour can follow Foreground (WlAccentInk) from the caller.
    -->
    <Style x:Key="WlDangerButton" TargetType="Button" BasedOn="{StaticResource WlGhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource WlAccentInk}" />
        <!-- Primary weight: it is the confirm button of its dialog, filled and deliberate. -->
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Surface" Background="{DynamicResource WlDanger}" CornerRadius="8"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- No hover LAYER here: this surface is an opaque fill, so a layer behind
                             it would never show. The dip is animated on the fill's own Opacity. -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0.88" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Surface"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!-- See WlGhostButton's own comment on this trigger pair. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                            <Setter TargetName="Surface" Property="BorderThickness" Value="1" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- The search field's 18px round clear button: WlLine fill, an 8px x glyph in WlText. -->
    <Style x:Key="WlSearchClearButton" TargetType="Button">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Fill="{DynamicResource WlLine}" />
                        <Path Data="{StaticResource WlCloseGeometry}" Stroke="{DynamicResource WlText}"
                              StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="8" Height="8" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The settings dialog's toggle (WHEN TO BACK UP). A CheckBox restyled as a 34x20 pill: off is
      transparent with a hairline-24% border and a muted knob; on fills WlAccent with the knob in
      WlAccentInk sliding right. Radius 999px per the design's "chip + toggle" rule. The knob's
      travel is expressed as a margin swap on IsChecked rather than an animation - the design's
      motion table gives no easing for a settings control, and a 220ms slide on something you flip
      once would read as decoration.

      High contrast: WlAccent maps to Highlight there (HighContrast.xaml), so the ON state already
      carries a guaranteed-contrast fill; the knob uses WlAccentInk (HighlightText) for the same
      reason WlFocusVisual switches to it on a Highlight-filled row. The OFF border steps up from
      WlLine2 to WlHotTrack in HC because 11-high-contrast.md forbids relying on a low-opacity hairline
      alone to define an interactive control's boundary there.
    -->
    <Style x:Key="WlToggle" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WlFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="34" Height="20" Background="Transparent">
                        <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                BorderBrush="{DynamicResource WlLine2}"
                                Background="Transparent" SnapsToDevicePixels="True" />
                        <Ellipse x:Name="Knob" Width="14" Height="14"
                                 Fill="{DynamicResource WlMuted}"
                                 HorizontalAlignment="Left" Margin="3,0,0,0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource WlAccent}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WlAccent}" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource WlAccentInk}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WlLine2}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!-- See WlGhostButton's own comment on this trigger pair. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The keep-count stepper's − / + segments: 32x34, hairline-24% border (WlLine2, the same stand-in
      WlSecondaryButton uses for its "hairline-24% border"), shared by both buttons so they read as
      one control with a value between them. The middle segment is not a Button - it is a plain
      Border in SettingsDialog.xaml carrying the mono value, which is why only this style lives here.
    -->
    <Style x:Key="WlStepperButton" TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="FontFamily" Value="{DynamicResource WlDisplayFont}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource WlFocusVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <!-- See WlGhostButton's own comment on why the hover is a layer. -->
                        <Border x:Name="HoverLayer" Background="{DynamicResource WlHover}"
                                CornerRadius="8" Opacity="0" />
                        <Border x:Name="Surface" Background="{TemplateBinding Background}"
                                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1"
                                CornerRadius="8" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="1" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="HoverLayer"
                                                         Storyboard.TargetProperty="Opacity"
                                                         To="0" Duration="0:0:0.14"
                                                         EasingFunction="{StaticResource WlStandardEase}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>

                        <!-- See WlGhostButton's own comment on this trigger pair. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsMouseOver" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Surface" Property="BorderBrush" Value="{DynamicResource WlHotTrack}" />
                        </MultiDataTrigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="False">
                                    <Condition.Binding>
                                        <Binding Path="IsEnabled" RelativeSource="{RelativeSource Self}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      ============================================================================================
      The scrollbar.

      Windows' own is a 17px grey trough with two arrow buttons, and it is the loudest thing in the
      settings dialog by some margin - a chrome-coloured column down the side of a design whose
      whole vocabulary is hairlines at 12%. The design never draws one, so this is derived from the
      rules rather than copied from a mock: 10px wide, no trough, no arrows, and a thumb that is a
      999px-radius bar in the same WlLine2 a secondary button's border uses, stepping to WlMuted on
      hover. That is the same "hairline steps to 24% when active" idiom the rest of the app follows.

      Declared WITHOUT an x:Key on purpose. An implicit style reaches every ScrollViewer in the
      app - the settings body, the backup list, and whatever a later screen adds - which is the
      only way the two ever agree. A keyed style would have to be applied one call site at a time,
      and the one that gets forgotten is the one the user sees.

      High contrast: WlLine2 resolves to WindowText there, so the thumb stays a solid, guaranteed-
      contrast bar rather than a low-opacity hairline. Nothing here needs an HC trigger.
      ============================================================================================
    -->
    <Style x:Key="WlScrollBarThumb" TargetType="Thumb">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <!-- Margin 3 inside a 10px bar leaves a 4px thumb with room to breathe; the
                         Grid keeps the full 10px hit target while only 4px of it is painted. -->
                    <Grid Background="Transparent">
                        <Border x:Name="Bar" Margin="3" CornerRadius="999"
                                Background="{DynamicResource WlLine2}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource WlMuted}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource WlMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      The page-up / page-down halves of the track. Invisible but hit-testable: clicking above or
      below the thumb must still page, and a RepeatButton with no template at all would inherit
      Windows' arrow button.
    -->
    <Style x:Key="WlScrollBarPageButton" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid x:Name="Root" Background="{TemplateBinding Background}"
                          SnapsToDevicePixels="True">
                        <!-- No Track.Increase/DecreaseRepeatButton arrows: the design has no arrow
                             buttons anywhere, and a scroll wheel or a drag covers both. -->
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageUpCommand"
                                              Style="{StaticResource WlScrollBarPageButton}" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource WlScrollBarThumb}" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="ScrollBar.PageDownCommand"
                                              Style="{StaticResource WlScrollBarPageButton}" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- IsDirectionReversed flips with the axis: a vertical track counts down
                             the screen, a horizontal one counts left to right. -->
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- The Width/Height setters have to swap with the axis, and a Setter cannot read
                 Orientation - hence a Style trigger rather than one more line above. -->
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
      2px, 2px offset, ALWAYS VISIBLE - including on the list rows, which is the one WPF makes you
      ask for, since a ListBoxItem's default focus visual is a dotted 1px rectangle that vanishes
      on a filled row.

      Colour: WlAccent normally. In high contrast that maps to Highlight (HighContrast.xaml), which
      is wrong on a SELECTED row - Task 10 fills a selected row with a full Highlight background
      there, so a Highlight ring on a Highlight fill would be invisible. So in high contrast the
      ring uses WlText (WindowText) by default, and only where the templated element is itself a
      selected ListBoxItem does it switch to WlAccentInk (HighlightText) - the readable-on-Highlight
      counterpart, and the same key WlRowTemplate's own selected+HC triggers already reuse for
      exactly this reason (RowStyles.xaml). The TemplatedParent.IsSelected path only resolves for a
      ListBoxItem; on every other control (a Button, the search TextBox) the condition simply never
      matches, leaving WlText - still correct there, since none of those are ever Highlight-filled.
    -->
    <Style x:Key="WlFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle x:Name="Ring" Margin="-2" StrokeThickness="2" SnapsToDevicePixels="True"
                               Stroke="{DynamicResource WlAccent}" />
                    <ControlTemplate.Triggers>
                        <DataTrigger Value="True">
                            <DataTrigger.Binding>
                                <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                            </DataTrigger.Binding>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource WlText}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="DataContext.IsHighContrast" RelativeSource="{RelativeSource AncestorType=Window}" />
                                    </Condition.Binding>
                                </Condition>
                                <Condition Value="True">
                                    <Condition.Binding>
                                        <Binding Path="IsSelected" RelativeSource="{RelativeSource TemplatedParent}" />
                                    </Condition.Binding>
                                </Condition>
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource WlAccentInk}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      Registered a second time under WPF's own well-known key: every default (non-overridden)
      Control.FocusVisualStyle resolves dynamically against SystemParameters.FocusVisualStyleKey,
      so aliasing it here is what makes the ring apply to every focusable element in the window -
      buttons, the search box, and every generated ListBoxItem row - without setting
      FocusVisualStyle one control at a time and missing one. The verbose ResourceKey= form below
      (not the shorthand curly-brace form) is deliberate - same reason RowStyles.xaml's own
      WlContentsUnknown/WlTierPresent/WlTierAbsent references use it: the guard test that every
      brush is a known theme key would otherwise flag a Style key as an unrecognised brush.
    -->
    <Style x:Key="{x:Static SystemParameters.FocusVisualStyleKey}"
           BasedOn="{StaticResource ResourceKey=WlFocusVisual}" />

    <!--
      The search TextBox itself, chromeless. The border, the icon, the placeholder and the clear
      button all live around it in MainWindow.xaml rather than in this template: a custom TextBox
      ControlTemplate needs only PART_ContentHost, and giving the surrounding chrome named
      elements of its own (SearchBox, ClearSearchButton) is what lets MainWindow.xaml.cs wire the
      clear button directly rather than reaching a FindName into a template's visual tree.
    -->
    <Style x:Key="WlSearchBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="CaretBrush" Value="{DynamicResource WlText}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FontFamily" Value="{DynamicResource WlDisplayFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}">
                        <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
