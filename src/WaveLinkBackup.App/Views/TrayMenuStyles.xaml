<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:WaveLinkBackup.App.Views">

    <!--
      The tray menu on the app's OWN palette, opaque.

      It used to sit on WlChrome behind a DWM Acrylic backdrop, and that was wrong twice over.
      WlChrome is specifically the "Windows 11 Mica caption/strip tint" role
      (the tokens spec) - a flat desaturated grey that only makes sense with a Mica
      surface behind it. With the backdrop not visibly landing, the menu read as neither native
      Windows nor this app: a grey box belonging to nothing.

      So the menu is now a FLOATING APP SURFACE - WlCard, the role the design gives a raised
      panel - with a WlLine2 hairline, because a popup over an unknown desktop needs a stronger
      edge than a panel inside a window does. Translucency is gone; the palette is the point.

      Rounded corners and the theme-matched frame stay: those are DWM doing something the app
      cannot do for itself, and they are not colour decisions.

      Every colour is a DynamicResource on a Wl* key. The guard test fails the build on a
      literal, and a literal is also what would stop the menu following the OS theme.
    -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/WaveLinkBackup;component/Views/Typography.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- The check for "Back up automatically". Lucide idiom, 24px grid, same as the tray glyphs. -->
    <!-- lucide/check, matching RowStyles.xaml's copy (technical-debt.md §4.7). -->
    <Geometry x:Key="WlCheckGeometry">M20 6 9 17l-5-5</Geometry>

    <Style x:Key="WlTrayMenu" TargetType="ContextMenu">
        <!--
          HasDropShadow MUST stay false. It is what stops the popup being a layered window, and a
          layered window ignores the DWM corner and frame attributes silently - the call succeeds
          and nothing changes. See plan 3, finding A.
        -->
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Background" Value="{DynamicResource WlCard}" />
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WlLine2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="5" />
        <Setter Property="MinWidth" Value="248" />
        <Setter Property="FontFamily" Value="{DynamicResource WlDisplayFont}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WlTrayMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource WlText}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Padding" Value="11,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border x:Name="Surface"
                            Background="{TemplateBinding Background}"
                            CornerRadius="6"
                            Padding="{TemplateBinding Padding}"
                            SnapsToDevicePixels="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="Label"
                                              Grid.Column="0"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />

                            <!--
                              A trailing check, which is how Windows 11 draws a checkable menu
                              item. The design's ASCII sketch writes [toggle]; a switch inside a
                              menu is not something Windows itself does, and this is the one place
                              the sketch is read as shorthand rather than literally.
                            -->
                            <Path x:Name="Check"
                                  Grid.Column="1"
                                  Margin="14,0,1,0"
                                  Width="15" Height="15"
                                  Stretch="Uniform"
                                  Visibility="Collapsed"
                                  Data="{StaticResource WlCheckGeometry}"
                                  Stroke="{DynamicResource WlAccent}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round" />
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--
                          WlHover is the same 4% lift the app's own list rows use. Subtle on
                          purpose; the text going to WlStrong is what makes it unmistakable
                          without turning every hover into a coloured band.
                        -->
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Surface" Property="Background"
                                    Value="{DynamicResource WlHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource WlStrong}" />
                        </Trigger>

                        <!--
                          Disabled is WlMuted, and in high contrast that key resolves to GrayText
                          at FULL opacity. 40% opacity is illegal there - transparency is not a
                          contrast guarantee (the high-contrast spec) - which is why this recolours rather
                          than dimming.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
      "Back up now" is the default item. the tray and updates spec gives it Rubik 500; WlStrong is what makes
      that read as the default rather than as an accident of weight.
    -->
    <Style x:Key="WlTrayMenuDefaultItem" TargetType="MenuItem" BasedOn="{StaticResource WlTrayMenuItem}">
        <Setter Property="Foreground" Value="{DynamicResource WlStrong}" />
        <Setter Property="FontWeight" Value="Medium" />
    </Style>

    <!--
      The header is a READOUT, not an item: no hover, no click, mono. "Anything a machine produced
      is mono; anything a person wrote is Rubik" - a timestamp and a count are machine-produced.

      Kept deliberately plain - muted mono text and nothing else. The design's own separator below
      it does the dividing; giving the readout a filled strip as well would put two competing
      dividers in the first 40px of an eleven-row menu.
    -->
    <Style x:Key="WlTrayMenuReadout" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
        <Setter Property="FontFamily" Value="{DynamicResource WlMonoFont}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border Background="Transparent"
                            Padding="11,9,11,5"
                            SnapsToDevicePixels="True">
                        <views:TrackedText Text="{TemplateBinding Header}"
                                           Tracking="0.14"
                                           VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="WlTrayMenuSeparator" TargetType="Separator">
        <Setter Property="Margin" Value="11,5" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource WlLine}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Fill="{TemplateBinding Background}"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
