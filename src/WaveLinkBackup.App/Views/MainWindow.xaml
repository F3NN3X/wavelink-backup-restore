<Window x:Class="WaveLinkBackup.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        xmlns:vm="clr-namespace:WaveLinkBackup.App.ViewModels"
         Title="Wave Link Backup"
         Height="760" Width="1180" MinHeight="560" MinWidth="1124"
         WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <!--
      MinWidth is 1124, not the 980 it was.

      The row's own six columns need 1084px, plus the list's 40px of padding - so at 980 the
      overflow cell was simply clipped, with no horizontal scroll and none designed (audit §2.9c).
      The design's own numbers do this to themselves: its six columns need 1084 in a window it
      allows to be 980 wide. Raising the floor is the answer that invents no visuals - the layout
      the design draws is now the only layout there is.
    -->

    <!--
      Background="Transparent", and AllowsTransparency stays FALSE.

      Mica renders BEHIND the client area, so anything the window paints hides it. And
      AllowsTransparency="True" would make the window layered, which makes DWM ignore the
      backdrop silently - the call succeeds and nothing looks different. Plan 3, finding A.

      WindowChrome gives the custom caption without needing either.
    -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="34"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!--
      The key map (ShellCommands, ViewModels/ShellCommands.cs), five of the seven bound at the
      window: Refresh, Search, BackUpNow, Rename, Delete, Restore. ClearSearch is deliberately NOT
      here - 10-decisions section 6 binds Escape only on the list and the search field (see
      SearchBox and the row ListScrollViewer below), or a window-wide binding would swallow Escape
      in the dialogs a later session adds.

      Restore's CanExecute is what keeps Enter from firing on an unselected or disallowed row - a
      guard inside Restore_Executed would still leave the command LOOKING live (WPF does not grey
      anything out on its own without CanExecute saying so).
    -->
    <Window.CommandBindings>
        <CommandBinding Command="{x:Static vm:ShellCommands.Refresh}" Executed="Refresh_Executed" />
        <CommandBinding Command="{x:Static vm:ShellCommands.Search}" Executed="Search_Executed" />
        <CommandBinding Command="{x:Static vm:ShellCommands.BackUpNow}"
                        Executed="BackUpNow_Executed" CanExecute="BackUpNow_CanExecute" />
        <CommandBinding Command="{x:Static vm:ShellCommands.Rename}"
                        Executed="Rename_Executed" CanExecute="Rename_CanExecute" />
        <CommandBinding Command="{x:Static vm:ShellCommands.Delete}"
                        Executed="Delete_Executed" CanExecute="Delete_CanExecute" />
        <CommandBinding Command="{x:Static vm:ShellCommands.Restore}"
                        Executed="Restore_Executed" CanExecute="Restore_CanExecute" />
    </Window.CommandBindings>

    <Window.Resources>
        <views:SentenceCaseConverter x:Key="WlSentenceCase" />
        <!-- The backing-up strip's 2px determinate bar. Same converter the Settings proportion
             bar uses: a 0..1 fraction and a track width in, that fraction of it out. -->
        <views:FractionToWidthConverter x:Key="WlFractionWidthConverter" />
    </Window.Resources>

    <!--
      IsSharedSizeScope lives HERE, on the root Grid, rather than on the ListBox the brief's own
      words name. The header (row 2) and the row template (three layers deep inside row 3's
      scroll region) are SIBLINGS under this Grid, not ancestor/descendant of each other - the
      attached property only shares sizes among elements that are BOTH inside the element it is
      set on, so it has to sit on their nearest common ancestor to reach both at once.
    -->
    <Grid Grid.IsSharedSizeScope="True">
        <Grid.RowDefinitions>
            <RowDefinition Height="34" />   <!-- caption: left unpainted, so Mica shows -->
            <RowDefinition Height="Auto" /> <!-- status strip -->
            <RowDefinition Height="Auto" /> <!-- restore-outcome strip (03) -->
            <RowDefinition Height="Auto" /> <!-- column header -->
            <RowDefinition Height="*" />    <!-- the list -->
            <RowDefinition Height="Auto" /> <!-- bottom bar -->
        </Grid.RowDefinitions>

        <!-- Solid WlBg behind everything BELOW the bar. README: "Mica/SystemBackdrop on the
             bar, solid wl-bg behind the list." -->
        <Border Grid.Row="1" Grid.RowSpan="5" Background="{DynamicResource WlBg}" />

        <Border x:Name="CaptionBar" Grid.Row="0"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Path Data="{StaticResource WlShieldCheckGeometry}"
                          Fill="{DynamicResource WlMuted}"
                          Width="14" Height="14" Stretch="Uniform" />
                    <TextBlock Text="Wave Link Backup" Margin="9,0,0,0" VerticalAlignment="Center"
                               FontFamily="{DynamicResource WlDisplayFont}" FontSize="12"
                               Foreground="{DynamicResource WlText}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimiseButton" Style="{StaticResource WlCaptionButton}"
                            AutomationProperties.Name="Minimise" Content="&#xE921;" />
                    <Button x:Name="MaximiseButton" Style="{StaticResource WlCaptionButton}"
                            AutomationProperties.Name="Maximise" Content="&#xE922;" />
                    <Button x:Name="CloseButton" Style="{StaticResource WlCaptionCloseButton}"
                            AutomationProperties.Name="Close" Content="&#xE8BB;" />
                </StackPanel>
            </Grid>
        </Border>

        <!--
          ================================================================================
          Row 1 - the status strip. 10,20 padding (CSS-order top/bottom 10, left/right 20,
          which in a WPF Thickness is written "20,10"), WlChrome, a hairline bottom edge,
          space-between: the dot+label on the left, the search field and the settings gear
          on the right.
          ================================================================================
        -->
        <Border Grid.Row="1" Background="{DynamicResource WlChrome}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1" Padding="20,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource WlOk}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                        <Setter Property="Fill" Value="{DynamicResource WlWarn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Neutral">
                                        <Setter Property="Fill" Value="{DynamicResource WlMuted}" />
                                    </DataTrigger>
                                    <!-- 03: a Rejected strip turns the status strip amber too, on top of
                                         StatusTone's own ShellFacts-derived value. Declared last so it wins. -->
                                    <DataTrigger Binding="{Binding Strip.TurnsStatusAmber}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource WlWarn}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!--
                      Default reads List.MatchSummary (07: what the strip shows while searching);
                      the DataTrigger below overrides it back to StatusStrip once the query is
                      empty - the same "default is the exception, a trigger restores the common
                      case" idiom RowStyles.xaml's own high-contrast MetaText trigger already
                      uses, just with the roles swapped.
                    -->
                    <views:TrackedText Margin="8,0,0,0" Tracking=".14"
                                        Foreground="{DynamicResource WlText}"
                                        VerticalAlignment="Center">
                        <views:TrackedText.Style>
                            <Style TargetType="views:TrackedText" BasedOn="{StaticResource WlStatusStripTrackedText}">
                                <Setter Property="Text" Value="{Binding List.MatchSummary}" />
                                <Setter Property="AutomationProperties.Name"
                                        Value="{Binding List.MatchSummary, Converter={StaticResource ResourceKey=WlSentenceCase}}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding List.Query}" Value="">
                                        <Setter Property="Text" Value="{Binding StatusStrip}" />
                                        <Setter Property="AutomationProperties.Name"
                                                Value="{Binding StatusStrip, Converter={StaticResource ResourceKey=WlSentenceCase}}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </views:TrackedText.Style>
                    </views:TrackedText>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!--
                      The search field. WlBg fill, hairline border (steps to WlLine2 while the
                      box has keyboard focus), 8px radius, a 14px search icon, an 18px round clear
                      button that appears once there is a query.

                      README's "8px x 11px padding" is 8 vertical / 11 horizontal, the same
                      vertical-first convention as the status strip's own "10px x 20px" - so
                      Padding="11,8". It carried "8,11", which squeezed the horizontal inset to 8
                      and stretched the field 6px taller than the design draws it.
                    -->
                    <Border x:Name="SearchBoxBorder" Width="216" Background="{DynamicResource WlBg}"
                            BorderThickness="1" CornerRadius="8" Padding="11,8">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource WlLine}" />
                                <!-- 08: with the folder gone there is nothing to search, so the
                                     field dims to 40% and stops taking input. -->
                                <Setter Property="IsEnabled" Value="True" />
                                <Style.Triggers>
                                    <DataTrigger Value="True">
                                        <DataTrigger.Binding>
                                            <Binding Path="IsKeyboardFocusWithin" ElementName="SearchBox" />
                                        </DataTrigger.Binding>
                                        <Setter Property="BorderBrush" Value="{DynamicResource WlLine2}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding List.State}" Value="FolderMissing">
                                        <Setter Property="Opacity" Value="0.4" />
                                        <Setter Property="IsEnabled" Value="False" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource WlSearchGeometry}"
                                  Stroke="{DynamicResource WlMuted}" StrokeThickness="1.6"
                                  Width="14" Height="14" Stretch="Uniform" Margin="0,0,6,0"
                                  VerticalAlignment="Center" />

                            <Grid Grid.Column="1">
                                <TextBlock Text="Search backups" VerticalAlignment="Center"
                                           IsHitTestVisible="False"
                                           FontFamily="{DynamicResource WlDisplayFont}" FontSize="13"
                                           Foreground="{DynamicResource WlMuted}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding List.Query}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox x:Name="SearchBox" Style="{StaticResource WlSearchBox}"
                                         Text="{Binding List.Query, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="Search backups"
                                         VerticalAlignment="Center">
                                    <!-- Escape clears the search only from HERE, not the window
                                         (10-decisions section 6) - see the comment on
                                         Window.CommandBindings above. -->
                                    <TextBox.CommandBindings>
                                        <CommandBinding Command="{x:Static vm:ShellCommands.ClearSearch}"
                                                        Executed="ClearSearch_Executed" />
                                    </TextBox.CommandBindings>
                                </TextBox>
                            </Grid>

                            <Button x:Name="ClearSearchButton" Grid.Column="2"
                                    Margin="6,0,0,0" VerticalAlignment="Center"
                                    AutomationProperties.Name="Clear the search">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource WlSearchClearButton}">
                                        <Setter Property="Visibility" Value="Visible" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding List.Query}" Value="">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </Grid>
                    </Border>

                    <Button x:Name="SettingsButton" Style="{StaticResource WlIconGhostButton}"
                            Margin="10,0,0,0" AutomationProperties.Name="Settings">
                        <Path Data="{StaticResource WlGearGeometry}" Stroke="{DynamicResource WlText}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="16" Height="16" Stretch="Uniform" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!--
          ================================================================================
          Row 2 - the restore-outcome strip (03-restore-outcomes.md). One inline strip below
          the status strip, above the column header, full width. Four outcomes, each a distinct
          visual state and a distinct dismiss rule:

            SucceededConfirmed   quiet: ringed check in WlOk, auto-dismisses after 6s
            SucceededUnconfirmed neutral hollow circle (NOT amber), "Check again" action
            Rejected             amber WlWarnSoft fill, 3px left edge, status strip turns amber,
                                 NOT dismissible until acted on (AcknowledgeReject)
            Failed               WlDanger, dismissible

          The XAML binds to the booleans RestoreOutcomeStrip exposes (IsVisible, HasLeftEdge,
          TurnsStatusAmber, Dismissible, HasAction) so the visual rules live in one place and
          the tests can assert them without standing up a window.
          ================================================================================
        -->
        <Border x:Name="RestoreOutcomeStripBorder" Grid.Row="2" Padding="20,10"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Setter Property="Background" Value="Transparent" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Strip.IsVisible}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>

                        <!-- Rejected: amber fill + 3px left edge. The status strip above turns
                             amber too - that is driven from code-behind on TurnsStatusAmber so
                             the existing StatusTone DataTrigger keeps its single source of truth. -->
                        <DataTrigger Binding="{Binding Strip.Kind}" Value="Rejected">
                            <Setter Property="Background" Value="{DynamicResource WlWarnSoft}" />
                            <Setter Property="BorderThickness" Value="3,0,0,1" />
                            <Setter Property="BorderBrush" Value="{DynamicResource WlWarn}" />
                        </DataTrigger>

                        <!-- Failed: danger fill. -->
                        <DataTrigger Binding="{Binding Strip.Kind}" Value="Failed">
                            <Setter Property="Background" Value="{DynamicResource WlDangerSoft}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--
                  06-errors.md, "Inline strips - anatomy": "22px mono wl-muted error number ·
                  11px hollow dot · sentence ... over mono meta ... · action · 26px dismiss ×".

                  The number is the first thing in the strip and the only place in the app that
                  prints an error's code, which is what makes a support conversation possible at
                  all. RestoreOutcomeStrip has carried ErrorNumber since it was built; nothing
                  rendered it, so an inline error arrived with an empty glyph slot where the
                  number belongs.
                -->
                <TextBlock Grid.Column="0" Text="{Binding Strip.ErrorNumber}"
                           FontFamily="{DynamicResource WlMonoFont}" FontSize="22"
                           Foreground="{DynamicResource WlMuted}" Margin="0,0,12,0"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Strip.IsInlineError}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!-- The outcome glyph: a ringed check (confirmed), a hollow circle
                     (unconfirmed - neutral, NOT amber, and the same marker every inline error
                     takes), a warning triangle (rejected), or a close-in-circle (failed). Each is
                     shown only for its own Kind. -->
                <Grid Grid.Column="1" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center">

                    <!-- SucceededConfirmed: ringed check in WlOk. -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="SucceededConfirmed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Stroke="{DynamicResource WlOk}" StrokeThickness="1.5" Fill="Transparent" />
                        <Path Data="{StaticResource WlCheckGeometry}" Stroke="{DynamicResource WlOk}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="10" Height="10" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <!-- SucceededUnconfirmed, and every inline error: the neutral hollow circle -
                         NOT amber. 06's inline-strip anatomy asks for the same 11px dot the
                         unconfirmed outcome uses, and for the same reason: nothing happened, so
                         nothing is un-whole. -->
                    <Ellipse Width="11" Height="11"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Setter Property="Stroke" Value="{DynamicResource WlMuted}" />
                                <Setter Property="Fill" Value="Transparent" />
                                <Setter Property="StrokeThickness" Value="1.5" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="SucceededUnconfirmed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Strip.IsInlineError}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <!-- Rejected: warning triangle in WlWarn. -->
                    <Path Data="{StaticResource WlWarningTriangleGeometry}" Stroke="{DynamicResource WlWarn}"
                          StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"
                          Width="16" Height="16" Stretch="Uniform">
                        <Path.Style>
                            <Style TargetType="Path">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="Rejected">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>

                    <!-- Failed: close-in-circle in WlDanger. -->
                    <Grid>
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="Failed">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Ellipse Stroke="{DynamicResource WlDanger}" StrokeThickness="1.5" Fill="Transparent" />
                        <Path Data="{StaticResource WlCloseGeometry}" Stroke="{DynamicResource WlDanger}"
                              StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              Width="9" Height="9" Stretch="Uniform"
                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Grid>

                <!--
                  Sentence over mono meta - 03 and 06 draw the same two lines, but an inline error
                  fills them from different properties. The catalog splits an error into a short
                  Title and the designed SENTENCE (Body, which the strip carries as Detail), and
                  the machine-specific line (a path, a PID, a checksum) arrives separately as
                  MonoMeta. Rendering Title/Detail unchanged put the designed sentence in the mono
                  meta role and dropped MonoMeta on the floor, so an inline error read as a short
                  heading over its own sentence in the wrong typeface, with no path or PID at all.
                -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource WlStrong}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WlBodyText}">
                                <!-- 03/06: the sentence is Rubik 400 13.5px. -->
                                <Setter Property="FontSize" Value="13.5" />
                                <Setter Property="Text" Value="{Binding Strip.Title}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.IsInlineError}" Value="True">
                                        <Setter Property="Text" Value="{Binding Strip.Detail}" />
                                    </DataTrigger>

                                    <!-- 03 §3: the rejected strip's HEADLINE is Rubik 500 14px,
                                         heavier than the other three states' sentence, because it
                                         is the only one reporting a configuration that is gone. -->
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="Rejected">
                                        <Setter Property="FontSize" Value="14" />
                                        <Setter Property="FontWeight" Value="Medium" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <!--
                      03 §3's BODY, which only the rejected strip has: "Restore 'Before restore'
                      to get back to where you were." Rubik 400 13px, wrapped, max 560px, and the
                      sentence that makes the primary button beside it mean something.
                    -->
                    <TextBlock Foreground="{DynamicResource WlText}" TextWrapping="Wrap"
                               MaxWidth="560" HorizontalAlignment="Left" Margin="0,4,0,0"
                               Text="{Binding Strip.Detail}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WlBodyText}">
                                <Setter Property="FontSize" Value="13" />
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="Rejected">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Foreground="{DynamicResource WlMuted}" Margin="0,2,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WlMonoMetaText}">
                                <Setter Property="Text" Value="{Binding Strip.Detail}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.IsInlineError}" Value="True">
                                        <Setter Property="Text" Value="{Binding Strip.MonoMeta}" />
                                    </DataTrigger>

                                    <!-- 03 §3 gives the rejected strip a headline, a BODY and a
                                         mono meta line - three rows, not two. The body is the
                                         sentence above; this is the machine line under it. -->
                                    <DataTrigger Binding="{Binding Strip.Kind}" Value="Rejected">
                                        <Setter Property="Text" Value="{Binding Strip.MonoMeta}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--
                  The secondary/ghost action: "Check again" on an unconfirmed restore, "Show the
                  log" on a rejected one, the designed action on an inline error.
                -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="StripActionButton"
                            Content="{Binding Strip.ActionLabel}"
                            Margin="16,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Strip.ActionLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WlSecondaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.HasAction}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!--
                      03-restore-outcomes.md §3's PRIMARY action, and the only one in the strip:
                      Restore "Before restore". It is the recovery path for the only failure that
                      costs someone their mixer, and until 0.6.1 the rejected strip named the way
                      back in prose and gave the user no way to take it (technical-debt.md §4.21).
                    -->
                    <Button x:Name="StripPrimaryActionButton"
                            Content="{Binding Strip.PrimaryActionLabel}"
                            Margin="8,0,0,0" VerticalAlignment="Center"
                            AutomationProperties.Name="{Binding Strip.PrimaryActionLabel}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource WlPrimaryButton}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Strip.HasPrimaryAction}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Close (X): shown whenever Dismissible. Rejected is never Dismissible, so it
                     cannot be closed - only AcknowledgeReject clears it. -->
                <Button Grid.Column="4" x:Name="StripDismissButton"
                        Margin="8,0,0,0" VerticalAlignment="Center"
                        AutomationProperties.Name="Dismiss">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WlSearchClearButton}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Strip.Dismissible}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!--
          ================================================================================
          Row 2 - the BACKING-UP strip (04-in-progress.md, first half). The same slot as the two
          strips below and above it, and mutually exclusive with both: a capture and a restore
          never run at once, and the outcome strip only fills once one of them has finished.

          Its half of 04 had no implementation at all - the restore half shipped complete and this
          was a BackupHost.IsCapturing flag that only the tray icon read (technical-debt.md §4.21
          item 2).

          The 2px bar is DETERMINATE, and its numbers are real: SnapshotWriteProgress reports bytes
          on disk against a total the payload knew before the first write. 04 bans a spinner
          because "a spinner implies uncertainty that does not exist here", which makes a
          determinate bar over invented stages the worse version of the same claim.
          ================================================================================
        -->
        <Border x:Name="BackingUpStrip" Grid.Row="2" Background="{DynamicResource WlChrome}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1"
                Padding="20,10,20,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding BackupProgress.IsCapturing}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- glyph + sentence + meta -->
                    <RowDefinition Height="Auto" /> <!-- the 2px determinate bar -->
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- hollow circle -->
                        <ColumnDefinition Width="*" />    <!-- sentence -->
                        <ColumnDefinition Width="Auto" /> <!-- mono meta, right -->
                    </Grid.ColumnDefinitions>

                    <!-- 04: an 11px HOLLOW circle in WlLine2. Neutral by construction - a backup
                         in flight is not a state anything has gone wrong in. -->
                    <Ellipse Grid.Column="0" Width="11" Height="11" Fill="Transparent"
                             Stroke="{DynamicResource WlLine2}" StrokeThickness="1"
                             VerticalAlignment="Center" Margin="0,0,10,0" />

                    <TextBlock Grid.Column="1" Text="{Binding BackupProgress.Sentence}"
                               Foreground="{DynamicResource WlStrong}" VerticalAlignment="Center"
                               Style="{StaticResource WlBodyText}" FontSize="13.5"
                               AutomationProperties.Name="Backup in progress" />

                    <TextBlock Grid.Column="2" Text="{Binding BackupProgress.Meta}"
                               Style="{StaticResource WlMonoMetaText}"
                               Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center"
                               HorizontalAlignment="Right"
                               AutomationProperties.Name="How much has been written" />
                </Grid>

                <!-- The bar sits ON the strip's bottom edge, full width, which is why the Border
                     above has no bottom padding. FractionToWidthConverter is the same one the
                     Settings proportion bar uses; the track's ActualWidth is its parameter. -->
                <Border Grid.Row="1" x:Name="BackupProgressTrack" Height="2"
                        Background="{DynamicResource WlLine}" HorizontalAlignment="Stretch">
                    <Border x:Name="BackupProgressFill" Height="2"
                            Background="{DynamicResource WlAccent}" HorizontalAlignment="Left">
                        <Border.Width>
                            <MultiBinding Converter="{StaticResource WlFractionWidthConverter}">
                                <Binding Path="BackupProgress.Fraction" />
                                <Binding ElementName="BackupProgressTrack" Path="ActualWidth" />
                            </MultiBinding>
                        </Border.Width>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!--
          ================================================================================
          Row 2 - the restore IN-PROGRESS strip (04-in-progress.md). Same slot as the outcome
          strip above: below the status strip, above the column header. The two are mutually
          exclusive by construction - this one shows while IsRestoring is true, the outcome one
          only once a restore has finished and fed Strip - so they never occupy the row at once.

          No spinner anywhere (04): a spinner implies uncertainty that does not exist here. A
          restore is four named steps, so the work is shown as four named stages advancing left
          to right: done = 14px check in WlOk, current = accent bottom rule, pending = muted at
          40%. The model (RestoreProgressModel) owns the frontier; this markup only renders each
          stage's status and the strip's chrome.
          ================================================================================
        -->
        <Border x:Name="RestoreInProgressStrip" Grid.Row="2" Background="{DynamicResource WlChrome}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1" Padding="20,14">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsRestoring}" Value="True">
                            <Setter Property="Visibility" Value="Visible" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" /> <!-- status line -->
                    <RowDefinition Height="Auto" /> <!-- reassurance line -->
                    <RowDefinition Height="Auto" /> <!-- the stage row -->
                </Grid.RowDefinitions>

                <!--
                  Row 0 - the status line: hollow dot + RESTORING "NAME" · WAVE LINK IS CLOSED, in
                  the same type as the window's own status strip. 10px below it comes the
                  reassurance line; 12px below that, the stage row.
                -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <!-- Hollow dot: 11px, 1px WlLine2 - the "in progress" marker, not a spinner. -->
                    <Ellipse Width="11" Height="11" VerticalAlignment="Center"
                             Stroke="{DynamicResource WlLine2}" StrokeThickness="1" Fill="Transparent" />
                    <views:TrackedText Margin="8,0,0,0" Tracking=".14" VerticalAlignment="Center"
                                        Text="{Binding RestoreStatusLabel}">
                        <views:TrackedText.Style>
                            <Style TargetType="views:TrackedText" BasedOn="{StaticResource WlStatusStripTrackedText}" />
                        </views:TrackedText.Style>
                    </views:TrackedText>
                </StackPanel>

                <!-- Row 1 - the reassurance line: Rubik 400 12.5px/1.5, WlMuted, max 600px. A polite
                     live region so a screen reader reads it once when the strip appears, then only
                     if its text changes (it never does) - not on every stage advance. -->
                <TextBlock Grid.Row="1" Text="{Binding RestoreProgress.Reassurance}" Margin="0,10,0,0"
                           FontFamily="{DynamicResource WlDisplayFont}" FontSize="12.5" LineHeight="19"
                           Foreground="{DynamicResource WlMuted}" MaxWidth="600"
                           HorizontalAlignment="Left" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Polite" />

                <!--
                  Row 2 - the stage row: four named stages, 26px 1px WlLine connectors between them,
                  and the mono readout pinned to the right end. Each stage is an Auto cell; the
                  connector between it and the next is its own Auto cell (a 26px-wide hairline).
                  The last stage has no connector after it.
                -->
                <Grid Grid.Row="2" Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" /> <!-- stage 0 -->
                        <ColumnDefinition Width="Auto" /> <!-- connector 1 -->
                        <ColumnDefinition Width="Auto" /> <!-- stage 1 -->
                        <ColumnDefinition Width="Auto" /> <!-- connector 2 -->
                        <ColumnDefinition Width="Auto" /> <!-- stage 2 -->
                        <ColumnDefinition Width="Auto" /> <!-- connector 3 -->
                        <ColumnDefinition Width="Auto" /> <!-- stage 3 -->
                        <ColumnDefinition Width="*" />    <!-- spacer to push the readout right -->
                        <ColumnDefinition Width="Auto" /> <!-- STEP n OF 4 · N SECONDS SO FAR -->
                    </Grid.ColumnDefinitions>

                    <!--
                      Each stage host carries an AutomationProperties.Name so a screen reader can
                      announce the current stage by name (e.g. "WRITING SETTINGS, in progress"). The
                      host's own code-behind keeps this in step with Stage.Status as the frontier
                      advances - see RestoreStageViewHost.UpdateAutomationName.
                    -->
                    <!-- Stage 0: CLOSING WAVE LINK. -->
                    <views:RestoreStageViewHost x:Name="Stage0" Grid.Column="0" Stage="{Binding RestoreProgress.Stages[0]}" />
                    <Border Grid.Column="1" Width="26" BorderBrush="{DynamicResource WlLine}"
                            BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <!-- Stage 1: WRITING SETTINGS. -->
                    <views:RestoreStageViewHost x:Name="Stage1" Grid.Column="2" Stage="{Binding RestoreProgress.Stages[1]}" />
                    <Border Grid.Column="3" Width="26" BorderBrush="{DynamicResource WlLine}"
                            BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <!-- Stage 2: STARTING WAVE LINK. -->
                    <views:RestoreStageViewHost Grid.Column="4" Stage="{Binding RestoreProgress.Stages[2]}" />
                    <Border Grid.Column="5" Width="26" BorderBrush="{DynamicResource WlLine}"
                            BorderThickness="0,0,0,1" VerticalAlignment="Bottom" Margin="0,0,0,8" />
                    <!-- Stage 3: CHECKING. -->
                    <views:RestoreStageViewHost x:Name="Stage3" Grid.Column="6" Stage="{Binding RestoreProgress.Stages[3]}" />

                    <!-- Right end: mono 11.5px WlMuted. "STEP 3 OF 4 · 2 SECONDS SO FAR", or DONE. -->
                    <TextBlock Grid.Column="8" Text="{Binding RestoreProgress.RightEndReadout}"
                               Style="{StaticResource WlMonoMetaText}" FontSize="11.5"
                               Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center" />
                </Grid>
            </Grid>
        </Border>

        <!--
          ================================================================================
          Row 3 - the column header. README: "11px top / 9px bottom x 20px padding" - which is
          Padding="20,11,20,9" in WPF's left,top,right,bottom order, NOT the "11,20,9,20" this
          carried, which read the CSS shorthand literally and put 11px on the LEFT. That was the
          ~9px header-vs-row misalignment the by-eye checklist (Part D) asked design to sign off:
          it is a transcription bug, not a design call - the rows' own 20px left inset was right
          all along, and the header now shares it.
          Hairline bottom, the same shared-size
          grid the row and this template both key off. Stays during a search (07); hides when
          the list has nothing to have columns FOR (Empty/FolderMissing), each of which renders
          its own copy of this same DataTemplate inside its row-4 stand-in instead.
          ================================================================================
        -->
        <Border x:Name="ColumnHeaderBorder" Grid.Row="3" BorderBrush="{DynamicResource WlLine}"
                BorderThickness="0,0,0,1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Visible" />
                    <Setter Property="Padding" Value="20,11,20,9" />
                    <Style.Triggers>
                        <!--
                          The NAME column is starred in both this header and every row, and each
                          resolves that star against its OWN available width. The rows sit inside
                          ListScrollViewer and lose 10px to the scroll bar the moment it appears;
                          this header does not. Without matching that gutter, NAME would be 10px
                          wider up here than down there and every column after it would sit 10px
                          right of the cells it heads. 30 = the 20px inset plus the 10px the
                          ScrollBar style pins its width to.
                        -->
                        <DataTrigger Value="Visible">
                            <DataTrigger.Binding>
                                <Binding Path="ComputedVerticalScrollBarVisibility"
                                         ElementName="ListScrollViewer" />
                            </DataTrigger.Binding>
                            <Setter Property="Padding" Value="20,11,30,9" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding List.State}" Value="Empty">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding List.State}" Value="FolderMissing">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <ContentControl ContentTemplate="{StaticResource WlColumnHeaderRowTemplate}" Focusable="False" />
        </Border>

        <!--
          ================================================================================
          Row 4 - the list, and its three stand-ins, one Grid with all four states stacked and
          switched by List.State. ONE state is ever visible at a time, so there is no visual
          overlap even though all four live in the same cell.
          ================================================================================
        -->
        <Grid Grid.Row="4">

            <!--
              Loaded: the groups, each a date header followed by its rows. Groups is already
              pre-grouped by the view model (SnapshotListViewModel.Groups), so this is an
              ItemsControl over Groups rather than a flat ListBox with GroupStyle - there is no
              flat row collection to hand a CollectionView, and building one here would mean
              re-deriving the TODAY/YESTERDAY grouping this ItemsControl's own data already
              carries.

              Each group's own Rows is now a real ListBox (10b fix), not a hand-placed
              ListBoxItem per row - the expansion moved INTO WlRowTemplate (RowStyles.xaml) so
              nothing stops this from being a genuine Selector any more. One ListBox per group is
              expected, and every one of them two-way binds the SAME List.Selected. That binding
              is what carries a CLICK up to the view model; it does NOT keep the groups in step
              with each other, which is what it was once believed to do. A Selector handed an item
              its own Items collection does not contain declines the write and keeps its existing
              container selected, so clicking through three date groups left three rows highlighted
              at once. What looks selected is decided by the ROW's own IsSelected instead - see
              WlRowTemplate (RowStyles.xaml), and
              MainWindowSelectionTests.Selecting_in_a_second_group_deselects_the_row_already_selected_in_the_first.
            -->
            <!--
              Loaded's own region: the scrollable rows above a fixed footer strip that appears
              only while a search is hiding rows (fix 1 - 07-search.md's footer strip was
              computed on the view model, SearchFooter/ShowAllLabel, and unit-tested, but never
              actually rendered anywhere). Visibility for List.State == Loaded now lives on THIS
              wrapping Grid rather than on ListScrollViewer directly, so the scroll region and the
              footer show and hide together.
            -->
            <Grid x:Name="ListLoadedRegion">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding List.State}" Value="Loaded">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

            <ScrollViewer x:Name="ListScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto"
                          CanContentScroll="True"
                          PreviewKeyDown="ListScrollViewer_PreviewKeyDown">
                <!-- Escape clears the search from anywhere in the list, same reasoning as
                     SearchBox's own CommandBindings above. -->
                <ScrollViewer.CommandBindings>
                    <CommandBinding Command="{x:Static vm:ShellCommands.ClearSearch}"
                                    Executed="ClearSearch_Executed" />
                </ScrollViewer.CommandBindings>

                <ItemsControl x:Name="GroupsHost" ItemsSource="{Binding List.Groups}" Focusable="False"
                              AutomationProperties.Name="Backups"
                              VirtualizingPanel.IsVirtualizing="True"
                              VirtualizingPanel.VirtualizationMode="Recycling"
                              VirtualizingPanel.ScrollUnit="Pixel">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <!-- Group header: same tracked role and tracking as the column
                                     header, no rule under it ("no separator line"). README gives
                                     "padding 14-16px 20px 7px" - 14 top, 20 each side, 7 bottom,
                                     i.e. Margin="20,14,20,7". The old "14,20,20,7" was the same
                                     CSS-order slip as the column header above, and it left every
                                     date header 6px left of the rows it introduces. -->
                                <views:TrackedText Text="{Binding Header}" Tracking=".18"
                                                    Margin="20,14,20,7"
                                                    Style="{StaticResource WlColumnHeaderTrackedText}"
                                                    Foreground="{DynamicResource WlMuted}" />

                                <!--
                                  ItemContainerStyle="{StaticResource WlRowTemplate}" is what makes
                                  this a real Selector: WPF generates one ListBoxItem per Row
                                  through that style, so native container-generation, arrow-key
                                  selection movement and Selector.SelectedItem all come free -
                                  nothing a hand-placed ListBoxItem could offer. No border, no
                                  background, no focus rectangle of its own: WlRowTemplate's own
                                  ControlTemplate owns the entire visual, including the row's
                                  selected-state fill - the ListBox itself should show nothing of
                                  its own.

                                  SelectedItem is OneWayToSource, and the direction is the whole
                                  point. It carries a CLICK up to the shared List.Selected and
                                  nothing back down.

                                  TwoWay - what this was - cannot work with one Selector per group.
                                  Selecting a row in group B writes it into group A's SelectedItem
                                  too; A does not contain that item, so it declines the write and
                                  writes its OWN current row back to the shared property; B then
                                  declines that and writes back; the two ListBoxes ping-pong
                                  through the one property until WPF's binding loop detection stops
                                  them, leaving both rows selected. What looks selected is decided
                                  by the ROW's own IsSelected instead (WlRowTemplate), which
                                  SnapshotListViewModel.Selected keeps to exactly one row across
                                  every group.

                                  It binds through the WINDOW's DataContext rather than this
                                  DataTemplate's own (which is the Row, then the Group) -
                                  List.Selected lives on the shared ShellViewModel, reached the
                                  same way the row template's own IsHighContrast checks already
                                  reach it (RelativeSource AncestorType=Window).
                                -->
                                <ListBox ItemsSource="{Binding Rows}"
                                         ItemContainerStyle="{StaticResource WlRowTemplate}"
                                         BorderThickness="0" Background="Transparent" Padding="0"
                                         FocusVisualStyle="{x:Null}"
                                         ScrollViewer.CanContentScroll="True"
                                         ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

                <!--
                  07: "footer strip mono 11px wl-muted: SHOWING 3 OF 14 . 11 HIDDEN BY THE
                  SEARCH; right: ghost button 'Show all 14'." List.SearchFooter is non-null
                  precisely when a query is filtering a Loaded list (SnapshotListViewModel.
                  SearchFooter), so this shows and hides on that alone - no separate State check
                  needed on top of ListLoadedRegion's own.
                -->
                <Border x:Name="SearchFooterBorder" Grid.Row="1" BorderBrush="{DynamicResource WlLine}"
                        BorderThickness="0,1,0,0" Padding="20,10">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding List.SearchFooter}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="{Binding List.SearchFooter}"
                                   Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center" />

                        <Button x:Name="ShowAllButton" Grid.Column="1"
                                Content="{Binding List.ShowAllLabel}"
                                Style="{StaticResource WlGhostButton}"
                                AutomationProperties.Name="{Binding List.ShowAllLabel}" />
                    </Grid>
                </Border>
            </Grid>

            <!--
              NoResults: the real treatment (07). No measure-rule frame - that frame belongs to
              first run (Empty), and reusing it here would make an empty RESULT look like an
              empty APP.
            -->
            <StackPanel x:Name="NoResultsPanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                        Margin="0,52,0,56">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding List.State}" Value="NoResults">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>

                <TextBlock Text="{Binding List.NoResultsTitle}" Style="{StaticResource WlBodyText}"
                           FontSize="15" Foreground="{DynamicResource WlStrong}"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <TextBlock Text="{Binding List.NoResultsDetail}" Style="{StaticResource WlMonoMetaText}"
                           Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0"
                           HorizontalAlignment="Center" TextAlignment="Center" />
                <!-- 07: "action  secondary \"Clear the search\", 6px above". Secondary, not
                     ghost: it is the only way out of an empty result, and a ghost button in the
                     middle of an otherwise empty panel has no edge to be found by. -->
                <Button x:Name="ClearSearchLinkButton" Content="Clear the search"
                        Style="{StaticResource WlSecondaryButton}" Margin="0,6,0,0"
                        HorizontalAlignment="Center" />
            </StackPanel>

            <!--
              Screen 4 (first-run / empty state). Replaces the list area: caption bar and bottom
              bar stay as usual, Restore/Rename/Delete hold at 40% (CanX is false - there is
              nothing to act on), Back up now stays live. The found-line renders only when Wave
              Link was discovered; the not-found variant is an open gap (technical-debt) and
              leaves the ok-dot line absent.
            -->
            <Grid x:Name="EmptyStandIn">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding List.State}" Value="Empty">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440">
                    <!-- Measure-rule frame: hairline above the title block, end ticks + inner
                         ticks at 12% and 38%, 16px from content. -->
                    <Grid Width="440" Height="12" Margin="0,0,0,16">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WlLine}"
                                VerticalAlignment="Bottom" />
                        <Border Width="1" Height="8" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Border Width="1" Height="8" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        <Border Width="1" Height="5" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" Margin="52.8,0,0,0"
                                VerticalAlignment="Bottom" />
                        <Border Width="1" Height="5" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" Margin="167.2,0,0,0"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock Text="No backups yet"
                               FontFamily="{DynamicResource WlDisplayFont}"
                               FontSize="30" FontWeight="Medium"
                               Foreground="{DynamicResource WlStrong}"
                               HorizontalAlignment="Center" />

                    <!-- Measure-rule frame below the title block. -->
                    <Grid Width="440" Height="12" Margin="0,16,0,16">
                        <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource WlLine}"
                                VerticalAlignment="Bottom" />
                        <Border Width="1" Height="8" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                        <Border Width="1" Height="8" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                        <Border Width="1" Height="5" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" Margin="52.8,0,0,0"
                                VerticalAlignment="Bottom" />
                        <Border Width="1" Height="5" Background="{DynamicResource WlLine}"
                                HorizontalAlignment="Left" Margin="167.2,0,0,0"
                                VerticalAlignment="Bottom" />
                    </Grid>

                    <TextBlock TextWrapping="Wrap" MaxWidth="430"
                               Text="Wave Link keeps about three days of its own copies. This keeps yours for as long as you like — every channel, every routing assignment, every effect chain."
                               FontFamily="{DynamicResource WlDisplayFont}"
                               FontSize="14.5" LineHeight="23"
                               Foreground="{DynamicResource WlMuted}"
                               HorizontalAlignment="Center" TextAlignment="Center" />

                    <!-- Actions: Back up now (primary, live) + Choose where to keep them
                         (secondary). 26px below the body. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,26,0,0">
                        <Button x:Name="EmptyBackUpNowButton" Content="Back up now"
                                Style="{StaticResource WlPrimaryButton}"
                                FontSize="15" Padding="12,0,12,0" MinWidth="130" />
                        <Button x:Name="ChooseWhereToKeepButton"
                                Content="Choose where to keep them" Margin="10,0,0,0"
                                Style="{StaticResource WlSecondaryButton}"
                                FontSize="14.5" Padding="14,0,14,0" />
                    </StackPanel>

                    <!-- Checkbox: reads and writes the real auto-backup setting (wired in
                         WireBottomBar). It used to be IsChecked="True" and nothing else - it
                         showed a state it had not read and changed a setting it never wrote. -->
                    <CheckBox x:Name="KeepAutoBackupCheckbox" Margin="0,22,0,0"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Foreground="{DynamicResource WlText}" FontSize="13.5">
                        <TextBlock Text="Keep backing up on its own when my settings change" />
                    </CheckBox>

                    <!-- Found-line (line 6): ok dot + mono line, then the settings path in
                         mono at 80%. Absent entirely when Wave Link was not found. -->
                    <StackPanel x:Name="FoundLinePanel" Margin="0,40,0,0" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FoundLine}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding FoundLine}" Value="">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WlOk}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding FoundLine}"
                                       FontFamily="{DynamicResource WlMonoFont}" FontSize="11.5"
                                       Foreground="{DynamicResource WlOk}" VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Text="{Binding FoundSettingsPath}"
                                   FontFamily="{DynamicResource WlMonoFont}" FontSize="11.5"
                                   Foreground="{DynamicResource WlMuted}" Opacity="0.8" />
                    </StackPanel>

                    <!--
                      06-errors.md, error 1, "First-run variant": the OTHER half of the line above.
                      When discovery found nothing there is no green found-line, and the design puts
                      an amber dot, the not-found sentence, the mono LOOKED IN line at 80%, and the
                      secondary button 10px below in its place.

                      FirstRunError1Label and FirstRunLookedInLabel have been implemented, correct
                      and unit-tested since plan 7; nothing referenced either of them, so a first run
                      on a machine with no Wave Link showed an empty gap (technical-debt.md §4.10 and
                      §4.21 item 3). An explicit settings path is what makes the app useful to a
                      non-MSIX user (§2.2), which is why the button matters more here than anywhere.
                    -->
                    <StackPanel x:Name="NotFoundPanel" Margin="0,40,0,0" HorizontalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <!-- Mirrors FoundLinePanel above: visible by default, collapsed
                                     when the label is null. The two are mutually exclusive by
                                     construction - FirstRunError1Label is non-null only when
                                     discovery failed, FoundLine only when it succeeded. -->
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding FirstRunError1Label}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource WlWarn}"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <views:TrackedText Text="{Binding FirstRunError1Label}"
                                               FontFamily="{DynamicResource WlMonoFont}" FontSize="11"
                                               FontWeight="Medium" Tracking="0.14"
                                               Foreground="{DynamicResource WlWarn}"
                                               VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center"
                                   Text="{Binding FirstRunLookedInLabel}"
                                   FontFamily="{DynamicResource WlMonoFont}" FontSize="11.5"
                                   Foreground="{DynamicResource WlMuted}" Opacity="0.8" />

                        <Button x:Name="ChooseSettingsFileButton" Margin="0,10,0,0"
                                HorizontalAlignment="Center"
                                Style="{StaticResource WlSecondaryButton}"
                                Content="Choose the settings file…"
                                AutomationProperties.Name="Choose the settings file" />
                    </StackPanel>

                    <!-- Footer strip: store path left, provenance line right. -->
                    <Grid Margin="0,40,0,0">
                        <TextBlock HorizontalAlignment="Left"
                                   Text="{Binding StorePath}"
                                   FontFamily="{DynamicResource WlMonoFont}" FontSize="11.5"
                                   Foreground="{DynamicResource WlMuted}" Opacity="0.8" />
                        <TextBlock HorizontalAlignment="Right"
                                   Text="FREE AND OPEN SOURCE · NOTHING LEAVES THIS COMPUTER"
                                   FontFamily="{DynamicResource WlMonoFont}" FontSize="11.5"
                                   Foreground="{DynamicResource WlMuted}" Opacity="0.8" />
                    </Grid>
                </StackPanel>
            </Grid>

            <!--
              FolderMissing: error 12's full screen (08-settings-persistence.md "The folder is
              gone"). It REPLACES the list entirely - no column header, no rows - and renders a
              centred body: an h2, the reason, the mono path, the last-seen line, and three
              actions. The status strip above (row 1) already says "BACKUP FOLDER UNAVAILABLE"
              with its ok-dot; the search field dims to 40% via IsEnabled below; and all four
              bottom-bar buttons hold at 40% because every CanX folds in not-FolderMissing.
            -->
            <Grid x:Name="FolderMissingStandIn">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding List.State}" Value="FolderMissing">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="430">
                    <TextBlock Text="{Binding List.FolderMissingTitle}" FontFamily="{DynamicResource WlDisplayFont}"
                               FontWeight="Medium" FontSize="26" LineHeight="31.2"
                               Foreground="{DynamicResource WlStrong}" HorizontalAlignment="Center"
                               TextAlignment="Center" />

                    <TextBlock Text="{Binding List.FolderMissingBody}" Style="{StaticResource WlBodyText}"
                               FontSize="14" Foreground="{DynamicResource WlText}" Margin="0,14,0,0"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" />

                    <TextBlock Text="{Binding List.FolderMissingPath}" FontFamily="{DynamicResource WlMonoFont}"
                               FontSize="13" Foreground="{DynamicResource WlStrong}" Margin="0,18,0,0"
                               HorizontalAlignment="Center" />

                    <TextBlock Text="{Binding List.FolderMissingLastSeen}" FontFamily="{DynamicResource WlMonoFont}"
                               FontSize="12" Foreground="{DynamicResource WlMuted}" Margin="0,6,0,0"
                               HorizontalAlignment="Center" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,24,0,0">
                        <Button x:Name="ChooseFolderButton" Style="{StaticResource WlPrimaryButton}"
                                Content="Choose a folder…" Click="ChooseFolder_Click"
                                AutomationProperties.Name="Choose a folder" />
                        <Button x:Name="LookAgainButton" Style="{StaticResource WlSecondaryButton}"
                                Margin="7,0,0,0" Content="Look again" Click="LookAgain_Click"
                                AutomationProperties.Name="Look again" />
                        <Button x:Name="UseDefaultFolderButton" Style="{StaticResource WlGhostButton}"
                                Margin="7,0,0,0" Content="Use the default folder" Click="UseDefaultFolder_Click"
                                AutomationProperties.Name="Use the default folder" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Grid>

        <!--
          ================================================================================
          Row 5 - the bottom bar. 12,20 padding (WPF order: left/right 20, top/bottom 12),
          WlChrome, hairline top, space-between: SelectedLine over SummaryLine on the left,
          the four action buttons 7px apart on the right.
          ================================================================================
        -->
        <Border Grid.Row="5" Background="{DynamicResource WlChrome}"
                BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0" Padding="20,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <views:TrackedText Text="{Binding SelectedLine}" Tracking=".14"
                                        Style="{StaticResource WlStatusStripTrackedText}"
                                        Foreground="{DynamicResource WlText}" />
                    <TextBlock Text="{Binding SummaryLine}" FontFamily="{DynamicResource WlMonoFont}"
                               FontWeight="Normal" FontSize="11" Margin="0,4,0,0"
                               Foreground="{DynamicResource WlMuted}" />

                    <!-- 08: when the folder is gone the bottom bar's left readout becomes this one
                         mono line, and nothing else - the selection/summary lines are absent. -->
                    <TextBlock x:Name="FolderMissingBottomLine"
                               Text="NOTHING CAN BE LISTED, TAKEN OR RESTORED UNTIL A FOLDER IS SET"
                               FontFamily="{DynamicResource WlMonoFont}" FontWeight="Normal" FontSize="11"
                               Foreground="{DynamicResource WlMuted}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding List.State}" Value="FolderMissing">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!--
                  While a restore runs the list actions and Back up now hold at 40% (04). Each
                  button's IsEnabled is bound to its own CanX, which already folds in not-IsRestoring
                  in the view model - so the disabled visual WPF applies IS the dim the design asks
                  for, and the same fact greys the keyboard shortcuts too (their CommandBinding
                  CanExecute reads these same properties). No converter needed: one source of truth.
                -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="RenameButton" Style="{StaticResource WlGhostButton}"
                            IsEnabled="{Binding CanRename}" AutomationProperties.Name="Rename">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlPencilGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Rename" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="DeleteButton" Style="{StaticResource WlGhostButton}" Margin="7,0,0,0"
                            IsEnabled="{Binding CanDelete}" AutomationProperties.Name="Delete">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlTrashGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Delete" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="RestoreButton" Style="{StaticResource WlSecondaryButton}" Margin="7,0,0,0"
                            IsEnabled="{Binding CanRestore}" AutomationProperties.Name="Restore this backup">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlRotateCcwGeometry}"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Restore this backup" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <Button x:Name="BackUpNowButton" Style="{StaticResource WlPrimaryButton}" Margin="7,0,0,0"
                            IsEnabled="{Binding CanBackUpNow}" AutomationProperties.Name="Back up now">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlDownloadTrayGeometry}" Stroke="{DynamicResource WlAccentInk}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Width="14" Height="14"
                                  Stretch="Uniform" VerticalAlignment="Center" />
                            <TextBlock Text="Back up now" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
