<Window x:Class="WaveLinkBackup.App.Views.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="Restore backup"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <!--
      Screen 2 - the restore confirmation, the app's only irreversible action.

      A borderless modal: WlScrim fills the whole window and the 620px WlCard card sits centred on
      top of it. WindowStyle=None rather than a custom caption bar because a dialog has no caption
      to host - its title is in the content, not the chrome. Background stays Transparent and
      AllowsTransparency stays FALSE (the same rule MainWindow's own comment states): this keeps
      the window non-layered, which is what lets DWM give it a drop shadow instead of the card
      having to draw one with a brush.

      The DataContext is a RestoreDialogModel set by the caller; every element below binds to it
      and computes nothing. Nothing here touches Core or does I/O - rendering only.
    -->
    <Grid>
        <!-- The scrim: what dims the window behind. Fills this borderless window edge to edge. -->
        <Border Background="{DynamicResource WlScrim}" />

        <!-- The card: 620px, WlCard surface, hairline-24% border (WlLine2), 8px radius. -->
        <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- content -->
                    <RowDefinition Height="Auto" /> <!-- footer -->
                </Grid.RowDefinitions>

                <!--
                  Content: 26px left/right, 26 top / 24 bottom (WPF Thickness "26,26,26,24"),
                  18px between blocks. The version note and the missing-plug-in block collapse to
                  zero height when their bound string is null, so the 18px spacing falls away with
                  them - no conditional margin needed.
                -->
                <StackPanel Grid.Row="0" Margin="26,26,26,24">

                    <!-- 1. Title: dialog title role, Rubik 500 20px/1.3. -->
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WlDialogTitleText}"
                               Foreground="{DynamicResource WlStrong}"
                               AutomationProperties.Name="Restore confirmation title" />

                    <!-- 2. Body: Rubik 400 14px/1.55, 18px below the title. -->
                    <TextBlock Text="{Binding Body}" Style="{StaticResource WlBodyText}"
                               Foreground="{DynamicResource WlText}" Margin="0,18,0,0" />

                    <!--
                      3. Version-mismatch note (09-restore-dialog-additions.md): a quiet mono line,
                      8px below the body and ABOVE the table. No fill, no icon, no border - the
                      lightest element on the screen. Collapses when null.
                    -->
                    <!-- Collapses when the model computed no mismatch (VersionMismatchNote is null). -->
                    <TextBlock Text="{Binding VersionMismatchNote}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0" LineHeight="17.8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WlMonoMetaText}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 4. Now-vs-after table: hairline border, 8px radius. -->
                    <Border Margin="0,18,0,0" BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True"
                            AutomationProperties.Name="What changes when you restore">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- header -->
                                <RowDefinition Height="*" />    <!-- rows -->
                            </Grid.RowDefinitions>

                            <!-- Header row on WlBg: blank, NOW (muted), AFTER RESTORE (accent). -->
                            <Border Grid.Row="0" Background="{DynamicResource WlBg}"
                                    BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1"
                                    Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <views:TrackedText Grid.Column="1" Text="NOW" Tracking=".18"
                                                       Style="{StaticResource WlColumnHeaderText}"
                                                       Foreground="{DynamicResource WlMuted}" />
                                    <views:TrackedText Grid.Column="2" Text="AFTER RESTORE" Tracking=".18"
                                                       Style="{StaticResource WlColumnHeaderText}"
                                                       Foreground="{DynamicResource WlAccent}" />
                                </Grid>
                            </Border>

                            <!-- Data rows, hairline between them. -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1">
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Label: Rubik 400 12.5px muted. -->
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource WlDisplayFont}"
                                                           FontSize="12.5" Foreground="{DynamicResource WlMuted}" />

                                                <!-- NOW value: mono 12.5px, muted. -->
                                                <TextBlock Grid.Column="1" Text="{Binding NowValue}" VerticalAlignment="Center"
                                                           Margin="16,0,0,0"
                                                           FontFamily="{DynamicResource WlMonoFont}"
                                                           FontSize="12.5" Foreground="{DynamicResource WlMuted}" />

                                                <!-- AFTER value: mono 12.5px. Changed earns WlStrong + a 5px accent dot;
                                                     unchanged stays muted with no dot. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                             Fill="{DynamicResource WlAccent}"
                                                             Visibility="Collapsed">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Margin" Value="0,0,7,0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding AfterValue}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="{DynamicResource WlMonoFont}" />
                                                                <Setter Property="FontSize" Value="12.5" />
                                                                <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WlStrong}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 5. Missing-plug-in warning: WlWarnSoft fill, hairline, 8px radius. -->
                    <Border Margin="0,18,0,0" CornerRadius="8" Padding="14,13"
                            Background="{DynamicResource WlWarnSoft}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                            AutomationProperties.Name="Missing plug-in warning">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Tag>
                            <Binding Path="MissingPluginWarning" />
                        </Border.Tag>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlWarningTriangleGeometry}"
                                  Fill="{DynamicResource WlWarn}"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" />
                            <TextBlock Text="{Binding MissingPluginWarning}" Margin="10,0,0,0"
                                       FontFamily="{DynamicResource WlDisplayFont}"
                                       FontSize="12.5" LineHeight="18.75" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WlText}" />
                        </StackPanel>
                    </Border>

                    <!-- 6. Reassurance: Rubik 400 12.5px muted, the way back. -->
                    <TextBlock Text="{Binding Reassurance}" Style="{StaticResource WlSecondaryText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,18,0,0" />
                </StackPanel>

                <!-- Footer: WlBg, hairline top, 18px vertical / 26px horizontal, right-aligned. -->
                <Border Grid.Row="1" Background="{DynamicResource WlBg}"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                        Padding="26,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel: secondary. Focus starts here; Escape is equivalent to it. -->
                        <Button x:Name="CancelButton" Content="Cancel" IsDefault="False"
                                Style="{StaticResource WlSecondaryButton}"
                                AutomationProperties.Name="Cancel restore" />

                        <!-- Restore this backup: the single destructive action, WlDanger, never accent. -->
                        <Button x:Name="RestoreButton" IsDefault="True" Margin="9,0,0,0"
                                Style="{StaticResource WlDangerButton}"
                                AutomationProperties.Name="Restore this backup">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource WlRotateCcwGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <TextBlock Text="Restore this backup" Margin="8,0,0,0" VerticalAlignment="Center"
                                           FontFamily="{DynamicResource WlDisplayFont}" FontWeight="Medium"
                                           FontSize="13.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
