<Window x:Class="WaveLinkBackup.App.Views.RestoreDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="Restore backup"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <!--
      Screen 2 - the restore confirmation, the app's only irreversible action.

      A borderless modal: WlScrim fills the whole window and the 620px WlCard card sits centred on
      top of it. WindowStyle=None rather than a custom caption bar because a dialog has no caption
      to host - its title is in the content, not the chrome. AllowsTransparency is TRUE here and false on
      MainWindow, and the difference is the point: a layered window's transparent regions really
      are transparent, so the scrim dims the app instead of compositing onto opaque black.
      DialogOverlay sizes this window to cover its owner and frosts what shows through; the card
      draws README's own shadow, since a layered window gets none from DWM.

      The DataContext is a RestoreDialogModel set by the caller; every element below binds to it
      and computes nothing. Nothing here touches Core or does I/O - rendering only.
    
      WindowStartupLocation is Manual, not CenterOwner: DialogOverlay positions this window over
      its owner on SourceInitialized, and CenterOwner would re-centre a full-owner-sized overlay
      afterwards, pushing it off by half the owner.
    -->
    <Grid>
        <!-- The scrim: what dims the app behind. Fills the overlay edge to edge, and the overlay
             spans the owner (DialogOverlay.Cover), so this reaches the app's own edges. -->
        <Border Background="{DynamicResource WlScrim}" />

        <!-- The card: 620px, WlCard surface, hairline-24% border (WlLine2), 8px radius. -->
        <Border Width="620" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                Effect="{StaticResource WlDialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />    <!-- content -->
                    <RowDefinition Height="Auto" /> <!-- footer -->
                </Grid.RowDefinitions>

                <!--
                  Content: 26px left/right, 26 top / 24 bottom (WPF Thickness "26,26,26,24"),
                  18px between blocks. The version note and the missing-plug-in block collapse to
                  zero height when their bound string is null, so the 18px spacing falls away with
                  them - no conditional margin needed.
                -->
                <StackPanel Grid.Row="0" Margin="26,26,26,24">

                    <!-- 1. Title: dialog title role, Rubik 500 20px/1.3. -->
                    <TextBlock Text="{Binding Title}" Style="{StaticResource WlDialogTitleText}"
                               Foreground="{DynamicResource WlStrong}"
                               AutomationProperties.Name="Restore confirmation title" />

                    <!-- 2. Body: Rubik 400 14px/1.55, 18px below the title. -->
                    <TextBlock Text="{Binding Body}" Style="{StaticResource WlBodyText}"
                               Foreground="{DynamicResource WlText}" Margin="0,18,0,0" />

                    <!--
                      3. Version-mismatch note (the restore-dialog additions spec): a quiet mono line,
                      8px below the body and ABOVE the table. No fill, no icon, no border - the
                      lightest element on the screen. Collapses when null.
                    -->
                    <!-- Collapses when the model computed no mismatch (VersionMismatchNote is null). -->
                    <TextBlock Text="{Binding VersionMismatchNote}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0" LineHeight="17.8">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource WlMonoMetaText}">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Text" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <!-- 4. Now-vs-after table: hairline border, 8px radius. -->
                    <Border Margin="0,18,0,0" BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                            CornerRadius="8" ClipToBounds="True"
                            AutomationProperties.Name="What changes when you restore">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /> <!-- header -->
                                <RowDefinition Height="*" />    <!-- rows -->
                            </Grid.RowDefinitions>

                            <!-- Header row on WlBg: blank, NOW (muted), AFTER RESTORE (accent). -->
                            <Border Grid.Row="0" Background="{DynamicResource WlBg}"
                                    BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1"
                                    Padding="14,9">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="104" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!--
                                      WlColumnHeaderTrackedText, not WlColumnHeaderText: the latter
                                      is TargetType="TextBlock" and TrackedText is a
                                      FrameworkElement, so applying it threw on construction and
                                      this dialog could not open at all. RestoreDialogViewTests now
                                      shows the window, which is what catches that class of mistake.
                                      README Screen 2 puts this header at 10px, a half-point below
                                      the row/column-header role the style carries.
                                    -->
                                    <views:TrackedText Grid.Column="1" Text="NOW" Tracking=".18" FontSize="10"
                                                       Style="{StaticResource WlColumnHeaderTrackedText}"
                                                       Foreground="{DynamicResource WlMuted}" />
                                    <views:TrackedText Grid.Column="2" Text="AFTER RESTORE" Tracking=".18" FontSize="10"
                                                       Style="{StaticResource WlColumnHeaderTrackedText}"
                                                       Foreground="{DynamicResource WlAccent}" />
                                </Grid>
                            </Border>

                            <!-- Data rows, hairline between them. -->
                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1">
                                            <Grid Margin="14,11">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="104" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!-- Label: Rubik 400 12.5px muted. -->
                                                <TextBlock Grid.Column="0" Text="{Binding Label}" VerticalAlignment="Center"
                                                           FontFamily="{DynamicResource WlDisplayFont}"
                                                           FontSize="12.5" Foreground="{DynamicResource WlMuted}" />

                                                <!-- NOW value: mono 12.5px, muted. -->
                                                <TextBlock Grid.Column="1" Text="{Binding NowValue}" VerticalAlignment="Center"
                                                           Margin="16,0,0,0"
                                                           FontFamily="{DynamicResource WlMonoFont}"
                                                           FontSize="12.5" Foreground="{DynamicResource WlMuted}" />

                                                <!-- AFTER value: mono 12.5px. Changed earns WlStrong + a 5px accent dot;
                                                     unchanged stays muted with no dot. -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="16,0,0,0">
                                                    <Ellipse Width="5" Height="5" VerticalAlignment="Center"
                                                             Fill="{DynamicResource WlAccent}"
                                                             Visibility="Collapsed">
                                                        <Ellipse.Style>
                                                            <Style TargetType="Ellipse">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                        <Setter Property="Margin" Value="0,0,7,0" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Ellipse.Style>
                                                    </Ellipse>
                                                    <TextBlock Text="{Binding AfterValue}" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="FontFamily" Value="{DynamicResource WlMonoFont}" />
                                                                <Setter Property="FontSize" Value="12.5" />
                                                                <Setter Property="Foreground" Value="{DynamicResource WlMuted}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Changed}" Value="True">
                                                                        <Setter Property="Foreground" Value="{DynamicResource WlStrong}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- 5. Missing-plug-in warning: WlWarnSoft fill, hairline, 8px radius. -->
                    <Border Margin="0,18,0,0" CornerRadius="8" Padding="14,13"
                            Background="{DynamicResource WlWarnSoft}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                            AutomationProperties.Name="Missing plug-in warning">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <Trigger Property="Tag" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Tag>
                            <Binding Path="MissingPluginWarning" />
                        </Border.Tag>
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource WlWarningTriangleGeometry}"
                                  Fill="{DynamicResource WlWarn}"
                                  Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" />
                            <!--
                              Two Runs, not one: README Screen 2 puts the clause that NAMES the
                              missing plug-in in WlStrong and the consequence in body colour. One
                              uniform paragraph buries the only sentence the user has to act on.
                              Same shape as the settings dialog's two plain-language notes, and
                              attribute-syntax bindings for the reason spelt out there.
                            -->
                            <TextBlock Margin="10,0,0,0"
                                       FontFamily="{DynamicResource WlDisplayFont}"
                                       FontSize="12.5" LineHeight="18.75" TextWrapping="Wrap"
                                       Foreground="{DynamicResource WlText}"
                                       AutomationProperties.Name="{Binding MissingPluginWarning}">
                                <Run FontWeight="Medium" Foreground="{DynamicResource WlStrong}"
                                     Text="{Binding MissingPluginLead, Mode=OneWay}" /><Run Text=" " /><Run
                                     Text="{Binding MissingPluginRest, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!--
                      6. The tier 4 opt-in (the elevation spec). Same row shape as the
                      Settings dialog's WHEN TO BACK UP rows: WlBg fill, hairline, 8px radius,
                      toggle right. BELOW the amber block because it is a control rather than a
                      warning, and ABOVE the reassurance because the reassurance is about the whole
                      restore and stays last.

                      Collapsed - not disabled - when the snapshot holds no plug-in binaries, which
                      is the common case since tier 4 is off by default. The whole Border goes, so
                      its 18px top margin goes with it.
                    -->
                    <Border Margin="0,18,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            AutomationProperties.Name="Also put the plug-in files back">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Visibility" Value="Visible" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding PluginFiles}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />    <!-- label + description + meta -->
                                <ColumnDefinition Width="Auto" /> <!-- toggle -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="14,14">
                                <TextBlock Text="{Binding PluginFiles.Title}"
                                           Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}" />
                                <TextBlock Text="{Binding PluginFiles.Description}"
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap" />
                                <!-- The honest figure, read off this snapshot's own manifest. -->
                                <TextBlock Text="{Binding PluginFiles.MetaText}"
                                           Style="{StaticResource WlMonoMetaText}"
                                           Foreground="{DynamicResource WlMuted}"
                                           Margin="0,6,0,0" />
                            </StackPanel>

                            <!-- OFF every time. Nothing writes this back to settings.json. -->
                            <CheckBox x:Name="PluginFilesToggle" Grid.Column="1"
                                      VerticalAlignment="Center" Margin="16,0"
                                      Style="{StaticResource WlToggle}"
                                      IsChecked="{Binding PluginFiles.Enabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Also put the plug-in files back" />
                        </Grid>
                    </Border>

                    <!-- 7. Reassurance: Rubik 400 12.5px muted, the way back. -->
                    <TextBlock Text="{Binding Reassurance}" Style="{StaticResource WlSecondaryText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,18,0,0" />
                </StackPanel>

                <!-- Footer: WlBg, hairline top, 18px vertical / 26px horizontal, right-aligned. -->
                <Border Grid.Row="1" Background="{DynamicResource WlBg}"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                        Padding="26,18">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <!-- Cancel: secondary. Focus starts here; Escape is equivalent to it. -->
                        <Button x:Name="CancelButton" Content="_Cancel" IsDefault="False"
                                Style="{StaticResource WlSecondaryButton}"
                                AutomationProperties.Name="Cancel restore" />

                        <!-- Restore this backup: the single destructive action, WlDanger, never accent. -->
                        <Button x:Name="RestoreButton" IsDefault="False" Margin="9,0,0,0"
                                Style="{StaticResource WlDangerButton}"
                                AutomationProperties.Name="Restore this backup">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource WlRotateCcwGeometry}"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.75" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Width="14" Height="14" Stretch="Uniform" VerticalAlignment="Center" />
                                <!-- AccessText, not TextBlock: Alt+R reaches the destructive
                                     button without the user having to Tab onto it, and the focus
                                     rule is unaffected - focus still starts on Cancel, and Enter
                                     still only fires this once the user has moved here. -->
                                <AccessText Text="_Restore this backup" Margin="8,0,0,0" VerticalAlignment="Center"
                                            FontFamily="{DynamicResource WlDisplayFont}" FontWeight="Medium"
                                            FontSize="13.5" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
