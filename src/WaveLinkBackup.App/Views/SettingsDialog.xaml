<Window x:Class="WaveLinkBackup.App.Views.SettingsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="Settings"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <Window.Resources>
        <!-- The trash row hides itself when there is no store to read (TrashRow is null). A
             DataTrigger cannot say "when it is NOT null show it", so the converter carries the
             predicate - see NotNullToVisibilityConverter. -->
        <views:NotNullToVisibilityConverter x:Key="TrashRowVisible" />
        <!-- The free-space line omits itself when the figure cannot be read (empty string) rather
               than print a number that is not there. Reuses the existing string converter from Views. -->
        <views:StringNotNullToVisibilityConverter x:Key="FreeSpaceLineVisible" />
        <!-- True → Visible, false → Collapsed. Used for row dividers - show on all but the last row. -->
        <views:BoolToVisibilityConverter x:Key="DividerVisible" />
        <!-- Error 9's in-place block, and the WHEN WINDOWS STARTS section, each hide themselves
             when their own bool is false. Separate keys from DividerVisible only so a future
             change to one cannot silently move the others. -->
        <views:BoolToVisibilityConverter x:Key="NotABackupFolderVisible" />
        <views:BoolToVisibilityConverter x:Key="StartupSectionVisible" />
        <!-- Fraction x track width -> segment width. The proportion bar's segments had no width
             binding at all and every one measured to zero, so the bar rendered as an empty track. -->
        <views:FractionToWidthConverter x:Key="FractionWidth" />

        <!-- WHAT GOES IN A BACKUP: each row's toggle binds IsChecked straight to the row's Enabled
             property (no converter needed). The locked rows also need IsEnabled=false, which is the
             inverse of Locked - a DataTrigger on the row item carries that predicate rather than a
             second converter. -->
        <Style x:Key="WhatGoesInToggle" TargetType="CheckBox" BasedOn="{StaticResource WlToggle}">
            <Style.Triggers>
                <!-- Locked now means "always included, no switch" (the settings file and the
                     effects list), not "not built yet" - phase 6 built the other two. So the
                     toggle is disabled and stays at full opacity: it is ON and unchangeable, and
                     the 40% off-treatment would read as the opposite of what it is. -->
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The size figure drops to 40% when its tier is not in a backup (locked rows), per the
             unbuilt-tier spec: "the KB/MB figure also drops to 40%". -->
        <Style x:Key="WhatGoesInSizeText" TargetType="TextBlock" BasedOn="{StaticResource WlMonoReadoutText}">
            <Setter Property="Foreground" Value="{DynamicResource WlText}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Enabled}" Value="False">
                    <Setter Property="Opacity" Value="0.4" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- The "NOT BUILT YET" badge is GONE, with phase 6. Every tier the dialog lists is now
             real, and a badge saying otherwise would be the one thing on this screen that lies. -->
    </Window.Resources>

    <!--
      The settings dialog (Screen 3), in its real shape - no Save button. Every control commits on
      change, so the footer's "CHANGES APPLY AS YOU MAKE THEM" is a fact, not a promise.

      The same overlay treatment as EmptyTrashDialog / DeleteDialog / RestoreDialog: a layered,
      owner-sized window carrying a WlScrim fill with the card centred on it, positioned and frosted
      by DialogOverlay. This dialog's card is wider than theirs (680px per the design) and taller,
      and it scrolls internally when its content exceeds the space - the ScrollViewer below owns
      that, and the card's MaxHeight is what caps it so the ScrollViewer has something to scroll
      WITHIN.

      This used to be the one dialog with no scrim: it was a fixed 680x540 window whose root WAS the
      card, so the app behind it stayed fully lit and it read as a second window rather than as a
      modal. It also carried ResizeMode=CanResizeWithGrip, which let the user drag a settings dialog
      to a size the design never describes. Both are gone; the card is a fixed 680 and the overlay
      handles the rest.

      The DataContext is a SettingsViewModel set by the caller; every element below binds to it and
      computes nothing. Nothing here touches Core or does I/O - rendering only. The Change folder… /
      Open / Empty trash buttons call back into App through code-behind, which is the one place this
      view crosses the VM boundary (a command would just wrap the same two lines).

      Sections, top to bottom: WHERE BACKUPS ARE KEPT (Task 2), WHEN TO BACK UP (Task 2), WHAT
      GOES IN A BACKUP (Task 3). WHICH WAVE LINK + WHERE THESE SETTINGS LIVE land in Task 4 as a
      new section between WHAT GOES IN A BACKUP and the footer. The 22px inter-section gap is the
      convention; keep it when adding.
    -->
    <Grid>
        <!-- The scrim: what dims the app behind. Fills the overlay edge to edge, and the overlay
             spans the owner (DialogOverlay.Cover), so this reaches the app's own edges. -->
        <Border Background="{DynamicResource WlScrim}" />

        <!--
          The card: 680px per the design, centred, and never taller than 640.

          Its height is min(its own content, 640, overlay - 48). Centred sizing is what keeps a
          short dialog short instead of a 680-wide column down a 4K screen; MaxHeight is what keeps
          a long one from becoming that column anyway; and the 24px margin keeps it off the
          overlay's edges. Whichever of the three wins, the body ScrollViewer gets the remainder and
          scrolls - which is the design's own "the settings dialog scrolls internally when it
          exceeds the window height".
        -->
        <Border Width="680" MaxHeight="640"
                HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,24"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                Effect="{StaticResource WlDialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- header -->
                <RowDefinition Height="*" />    <!-- scrolling body -->
                <RowDefinition Height="Auto" /> <!-- footer -->
            </Grid.RowDefinitions>

            <!-- Header: "Settings" (dialog title) + a 30x30 close button. Hairline bottom. -->
            <Border Grid.Row="0" Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}" BorderThickness="0,0,0,1"
                    Padding="24,16">
                <Grid>
                    <TextBlock Text="Settings" Style="{StaticResource WlDialogTitleText}"
                               Foreground="{DynamicResource WlStrong}"
                               VerticalAlignment="Center"
                               AutomationProperties.Name="Settings dialog title" />
                    <!-- Close: 30x30 ghost. IsCancel so Escape and the X are equivalent; the
                         code-behind's OnKeyDown is a belt-and-braces for the standalone case. -->
                    <Button x:Name="CloseButton" Width="30" Height="30" IsCancel="True"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource WlIconGhostButton}"
                            AutomationProperties.Name="Close settings">
                        <Path Data="M5 5 L19 19 M19 5 L5 19" StrokeThickness="1.75"
                              Stroke="{DynamicResource WlMuted}" Stretch="None" />
                    </Button>
                </Grid>
            </Border>

            <!-- Body: scrolls internally when it exceeds the window height (Task 6's requirement,
                 wired here so later tasks inherit it). Padding 0 24px 20px; 22px between sections. -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,22,24,20">

                    <!-- ============ WHERE BACKUPS ARE KEPT ============ -->
                    <views:TrackedText Text="WHERE BACKUPS ARE KEPT" Tracking=".18"
                               Style="{StaticResource WlColumnHeaderTrackedText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,0,0,10"
                               AutomationProperties.Name="Where backups are kept section" />

                    <!-- Read-only path field: WlSunken fill, hairline border, 8px radius,
                         10px x 12px padding, 15px folder icon + mono 12.5px ellipsised path. -->
                    <Border Background="{DynamicResource WlSunken}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            Padding="12,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" /> <!-- folder icon -->
                                <ColumnDefinition Width="*" />    <!-- path -->
                            </Grid.ColumnDefinitions>

                            <Path Grid.Column="0" Data="{StaticResource WlFolderGeometry}"
                                  Fill="{DynamicResource WlMuted}" Stretch="Uniform"
                                  Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,9,0" />

                            <TextBlock Grid.Column="1" Text="{Binding BackupFolder}"
                                       Style="{StaticResource WlMonoReadoutText}"
                                       Foreground="{DynamicResource WlText}"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding BackupFolder}"
                                       AutomationProperties.Name="Backup folder path" />
                        </Grid>
                    </Border>

                    <!-- Change folder… (secondary) + Open (ghost), right-aligned, 9px apart. -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,9,0,0">
                        <Button x:Name="ChangeFolderButton" Content="Change folder…"
                                Style="{StaticResource WlSecondaryButton}"
                                AutomationProperties.Name="Change the backup folder" />
                        <Button x:Name="OpenFolderButton" Content="Open" Margin="9,0,0,0"
                                Style="{StaticResource WlGhostButton}"
                                AutomationProperties.Name="Open the backup folder" />
                    </StackPanel>

                    <!-- The errors spec §9, in place, right after "Change folder…" - which is where the
                      design puts it, and the reason it is not a modal: it is a fact about the
                      button directly above it. Amber, because a store pointing at the wrong folder
                      means the user's backups are not reachable.

                      The placement TABLE at the top of 06 files error 9 under Dialogs; §9's own
                      text ("appears in Settings, in place") is the more specific instruction, and
                      it is what this implements.
                    -->
                    <Border x:Name="NotABackupFolderBlock" Margin="0,10,0,0"
                            Background="{DynamicResource WlWarnSoft}"
                            BorderBrush="{DynamicResource WlWarn}" BorderThickness="3,0,0,0"
                            CornerRadius="8" Padding="16,14"
                            Visibility="{Binding ShowsNotABackupFolder, Converter={StaticResource NotABackupFolderVisible}}">
                        <StackPanel>
                            <TextBlock Text="{Binding NotABackupFolderTitle}"
                                       Style="{StaticResource WlRowNameText}"
                                       Foreground="{DynamicResource WlStrong}"
                                       AutomationProperties.Name="Not a backup folder title" />
                            <TextBlock Text="{Binding NotABackupFolderBody}"
                                       Style="{StaticResource WlSecondaryText}"
                                       Foreground="{DynamicResource WlText}" Margin="0,4,0,0"
                                       TextWrapping="Wrap" LineHeight="19.575"
                                       AutomationProperties.Name="Not a backup folder explanation" />
                            <TextBlock Text="{Binding NotABackupFolderMeta}"
                                       Style="{StaticResource WlMonoMetaText}"
                                       Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0"
                                       AutomationProperties.Name="Not a backup folder details" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                <Button x:Name="ChooseAnotherFolderButton" Content="Choose another…"
                                        Style="{StaticResource WlSecondaryButton}"
                                        AutomationProperties.Name="Choose another backup folder" />
                                <Button x:Name="KeepCurrentFolderButton" Content="Keep the current folder"
                                        Margin="9,0,0,0" Style="{StaticResource WlGhostButton}"
                                        AutomationProperties.Name="Keep the current backup folder" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Drive stats line: mono 11.5px, muted. The design's full line -
                         "N BACKUPS · X MB USED · Y GB FREE ON THIS DRIVE" - is now complete: the
                         count and the used bytes are set by the caller from the same store read
                         that fills the trash row, and each of the three omits itself when it
                         cannot be read (audit §2.9a). -->
                    <TextBlock Margin="0,10,0,0" Style="{StaticResource WlMonoMetaText}"
                               Foreground="{DynamicResource WlMuted}"
                               Text="{Binding FreeSpaceText}"
                               Visibility="{Binding FreeSpaceText, Converter={StaticResource FreeSpaceLineVisible}}"
                               AutomationProperties.Name="Free space on the backup drive" />

                    <!-- The Plan-6 trash row, hosted directly under the folder controls. It is a fact
                         about this folder (its volume decides whether emptying confirms), which is why
                         it lives here rather than in its own section. Hides itself when TrashRow is null
                         (no store to read). -->
                    <Border Margin="0,14,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding TrashRow, Converter={StaticResource TrashRowVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />    <!-- title + description + mono -->
                                <ColumnDefinition Width="Auto" /> <!-- Empty trash -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,12">
                                <TextBlock Text="{Binding TrashRow.Title}" Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Trash row title" />
                                <TextBlock Text="{Binding TrashRow.Description}" Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           AutomationProperties.Name="Trash row description" />
                                <TextBlock Text="{Binding TrashRow.MonoLine}" Style="{StaticResource WlMonoMetaText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,6,0,0"
                                           AutomationProperties.Name="Trash row statistics" />

                                <!-- Live empty-trash progress: shown only while the operation is in flight.
                                     The sentence replaces the title's role ("Removing 3 of 7…") and the
                                     determinate bar below it tracks real removals - no spinner, no guesswork. -->
                                <StackPanel Margin="0,8,0,0"
                                            Visibility="{Binding TrashProgress, Converter={StaticResource TrashRowVisible}}">
                                    <TextBlock Text="{Binding TrashProgress.Sentence}" Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlMuted}"
                                               AutomationProperties.Name="Trash empty progress" />
                                    <Border x:Name="TrashProgressTrack" Height="2" Margin="0,6,0,0"
                                            Background="{DynamicResource WlLine}" HorizontalAlignment="Stretch">
                                        <Border Height="2" HorizontalAlignment="Left"
                                                Background="{DynamicResource WlDanger}">
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource FractionWidth}">
                                                    <Binding Path="TrashProgress.Fraction" />
                                                    <Binding ElementName="TrashProgressTrack" Path="ActualWidth" />
                                                </MultiBinding>
                                            </Border.Width>
                                        </Border>
                                    </Border>
                                </StackPanel>
                            </StackPanel>

                            <!-- Empty trash: secondary. 40% opacity + not interactive when the trash is
                                 empty (ActionEnabled false) - the row STAYS VISIBLE, per the design. -->
                            <Button x:Name="EmptyTrashButton" Grid.Column="1" Content="Empty trash"
                                    VerticalAlignment="Center" Margin="16,0"
                                    Style="{StaticResource WlSecondaryButton}"
                                    IsEnabled="{Binding TrashRow.ActionEnabled}"
                                    AutomationProperties.Name="Empty the trash" />
                        </Grid>
                    </Border>

                    <!-- ============ WHEN TO BACK UP ============ -->
                    <views:TrackedText Text="WHEN TO BACK UP" Tracking=".18"
                               Style="{StaticResource WlColumnHeaderTrackedText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                               AutomationProperties.Name="When to back up section" />

                    <!-- Row 1: the auto-backup toggle. WlBg fill, hairline border, 8px radius. -->
                    <Border Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />    <!-- label + description -->
                                <ColumnDefinition Width="Auto" /> <!-- toggle -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Text="Back up on its own when my settings change"
                                           Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Automatic backup label" />
                                <!-- "at most one an hour" left this sentence when it stopped being
                                     a constant: the row below is where that number lives now. -->
                                <TextBlock Text="Wave Link writes its file the moment you touch a channel. This notices, waits a minute, then keeps a copy."
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           AutomationProperties.Name="Automatic backup description" />
                            </StackPanel>

                            <!-- The toggle commits on change through the VM (no Save button). -->
                            <CheckBox Grid.Column="1" VerticalAlignment="Center" Margin="16,0"
                                      Style="{StaticResource WlToggle}"
                                      IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Back up on its own when my settings change" />
                        </Grid>
                    </Border>

                    <!-- Row 2: how often, at most (the backup-timing spec). A cap on
                         change-driven backups, not a timer: nothing is written when nothing changes,
                         so lowering it does not make the app busier on a quiet machine. The title is
                         the VALUE READ BACK - bound, not fixed - so label and control cannot drift. -->
                    <Border Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Text="{Binding IntervalLabel}"
                                           Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Automatic backup interval label" />
                                <TextBlock Text="A burst of changes still leaves you one copy, not thirty."
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Automatic backup interval description" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                <Button x:Name="DecrementIntervalButton" Content="−"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Back up less often" />
                                <Border Width="62" Height="34" Background="{DynamicResource WlSunken}"
                                        BorderBrush="{DynamicResource WlLine2}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding IntervalText}"
                                               Style="{StaticResource WlMonoReadoutText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="Shortest gap between automatic backups" />
                                </Border>
                                <Button x:Name="IncrementIntervalButton" Content="+" Margin="-1,0,0,0"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Back up more often" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 3: the daily backup switch. -->
                    <Border Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Text="Also back up at a set time each day"
                                           Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Daily backup label" />
                                <TextBlock Text="Whether or not anything changed. A backup you took yourself earlier does not cancel it - only today's own copy of this one does."
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Daily backup description" />
                            </StackPanel>

                            <CheckBox x:Name="DailyBackupToggle" Grid.Column="1"
                                      VerticalAlignment="Center" Margin="16,0"
                                      Style="{StaticResource WlToggle}"
                                      IsChecked="{Binding DailyBackupEnabled, Mode=TwoWay}"
                                      AutomationProperties.Name="Also back up at a set time each day" />
                        </Grid>
                    </Border>

                    <!-- Row 4: the time itself. HIDDEN when the switch is off, the same rule the
                         WHICH WAVE LINK section follows - a control with no effect is worse than no
                         control. Half-hour steps, wrapping at midnight, 24-hour mono. -->
                    <Border x:Name="DailyTimeRow" Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            Visibility="{Binding DailyBackupEnabled, Converter={StaticResource DividerVisible}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Daily backup time label">
                                    <Run Text="Every day at" /><Run Text=" " /><Run Text="{Binding DailyTimeText, Mode=OneWay}" />
                                </TextBlock>
                                <!-- Said plainly rather than left for the user to discover by losing
                                     a whole night. This is not a scheduled task. -->
                                <TextBlock Text="Your computer has to be awake and this app running."
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Daily backup time description" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                <Button x:Name="DecrementDailyTimeButton" Content="−"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Earlier daily backup time" />
                                <Border Width="62" Height="34" Background="{DynamicResource WlSunken}"
                                        BorderBrush="{DynamicResource WlLine2}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding DailyTimeText}"
                                               Style="{StaticResource WlMonoReadoutText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="Daily backup time" />
                                </Border>
                                <Button x:Name="IncrementDailyTimeButton" Content="+" Margin="-1,0,0,0"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Later daily backup time" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Row 5: the keep-count stepper. LAST, deliberately: it is about what happens
                         to backups after they exist, and everything above it is about when they are
                         made. Same row shape, 10px below the row before it. -->
                    <Border Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />    <!-- label + description -->
                                <ColumnDefinition Width="Auto" /> <!-- stepper -->
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="16,14">
                                <TextBlock Text="{Binding KeepCountLabel}"
                                           Style="{StaticResource WlRowNameText}"
                                           Foreground="{DynamicResource WlStrong}"
                                           AutomationProperties.Name="Keep count label" />
                                <TextBlock Text="Backups you took yourself are never deleted."
                                           Style="{StaticResource WlSecondaryText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                           AutomationProperties.Name="Keep count description" />
                            </StackPanel>

                            <!-- Stepper: − / value / +. The middle segment is a plain Border (not a
                                 Button) carrying the mono value - see WlStepperButton's own comment.
                                 32x34 segments, hairline-24% border, 8px radius, joined into one control. -->
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0">
                                <Button x:Name="DecrementKeepCountButton" Content="−"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Decrease how many automatic backups to keep" />
                                <Border Width="52" Height="34" Background="{DynamicResource WlSunken}"
                                        BorderBrush="{DynamicResource WlLine2}" BorderThickness="1"
                                        CornerRadius="8">
                                    <TextBlock Text="{Binding AutoBackupKeepCount}"
                                               Style="{StaticResource WlMonoReadoutText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               AutomationProperties.Name="How many automatic backups to keep" />
                                </Border>
                                <Button x:Name="IncrementKeepCountButton" Content="+" Margin="-1,0,0,0"
                                        Style="{StaticResource WlStepperButton}"
                                        AutomationProperties.Name="Increase how many automatic backups to keep" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ============ WHAT GOES IN A BACKUP ============ -->
                    <views:TrackedText Text="WHAT GOES IN A BACKUP" Tracking=".18"
                               Style="{StaticResource WlColumnHeaderTrackedText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                               AutomationProperties.Name="What goes in a backup section" />

                    <!-- One bordered group, four rows on a 1fr/84px/52px grid (label+description,
                         size, control), the tray and updates spec x 16px padding, hairline between rows. The group is
                         WlBg with a hairline border and 8px radius; each row's bottom hairline is the
                         divider (the last row carries none). Sizes are honest and right-aligned in mono. -->
                    <Border Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                        <ItemsControl ItemsSource="{Binding WhatGoesIn.Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />     <!-- label + description -->
                                            <ColumnDefinition Width="84" />    <!-- size (right-aligned) -->
                                            <ColumnDefinition Width="52" />    <!-- toggle / badge -->
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Margin="0,13">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource WlRowNameText}"
                                                       Foreground="{DynamicResource WlStrong}" />
                                            <TextBlock Text="{Binding Description}" Style="{StaticResource WlSecondaryText}"
                                                       Foreground="{DynamicResource WlMuted}" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        </StackPanel>

                                        <!-- The honest size figure; drops to 40% when the tier is not in a backup. -->
                                        <TextBlock Grid.Column="1" Text="{Binding SizeText}"
                                                   Style="{StaticResource WhatGoesInSizeText}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />

                                         <!-- Control cell: the toggle for EVERY tier. The two always-included tiers keep a
                                              PRESENT but disabled toggle rather than losing it, so a screen reader announces
                                              "on, unavailable" instead of dropping the control from the tree. IsChecked is TwoWay:
                                              this is where the user switches presets and plug-in files on, and WhatGoesInRow
                                              refuses a set on a locked row regardless of what the view asks for. -->
                                          <Grid Grid.Column="2">
                                              <CheckBox VerticalAlignment="Center" HorizontalAlignment="Right"
                                                        Style="{StaticResource WhatGoesInToggle}"
                                                        IsChecked="{Binding Enabled, Mode=TwoWay}" />
                                          </Grid>



                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>

                    <!-- The 6px stacked proportion bar on WlSunken, derived from the enabled tiers
                         (recomputed, never hard-coded). Each segment's width is its Fraction of the
                         whole; a 1px hairline gap separates segments. Below it: the two mono labels. -->
                    <Border x:Name="ProportionTrack" Height="6" Margin="0,12,0,0"
                            Background="{DynamicResource WlSunken}" CornerRadius="3">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding WhatGoesIn.Segments}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border x:Name="ProportionSegment" Margin="0,0,1,0">
                                            <!--
                                              Object-element syntax, so the MultiBinding is a real
                                              binding rather than literal text - the same XAML rule
                                              the two plain-language notes below fell foul of.

                                              RelativeSource, not ElementName: an ItemTemplate is
                                              its own namescope, so a name declared outside it does
                                              not resolve from in here. The nearest ItemsControl
                                              ancestor IS the bar, and it stretches to the track.
                                            -->
                                            <Border.Width>
                                                <MultiBinding Converter="{StaticResource FractionWidth}">
                                                    <Binding Path="Fraction" Mode="OneWay" />
                                                    <Binding Path="ActualWidth" Mode="OneWay"
                                                             RelativeSource="{RelativeSource AncestorType=ItemsControl}" />
                                                </MultiBinding>
                                            </Border.Width>
                                            <!--
                                              The bar is the app's own red (WlDanger) in every segment.
                                              The segments still carry meaning - their WIDTHS are the
                                              byte share of each tier, and the high-contrast legend below
                                              names them - but the fill no longer doubles as a tier colour
                                              code; one colour reads as "this is the bar" rather than a
                                              four-colour chart.
                                            -->
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource WlDanger}" />
                                                </Style>
                                            </Border.Style>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>

                    <!-- The high-contrast spec: "The proportion bar in Settings loses its colour
                      segments; label the segments instead."

                      In high contrast every fill in this app is transparent, so the bar above
                      becomes one undifferentiated track and its encoding is simply gone. This is
                      what replaces it: the same four segments, named and sized, in the order they
                      sit in the bar (audit §2.9b). Hidden entirely otherwise - in the three colour
                      themes the bands carry the meaning and this would be a duplicate readout.
                    -->
                    <ItemsControl x:Name="ProportionLegend" Margin="0,8,0,0"
                                  ItemsSource="{Binding WhatGoesIn.Segments}"
                                  Visibility="{Binding IsHighContrast, Converter={StaticResource StartupSectionVisible}}"
                                  AutomationProperties.Name="What each part of the bar is">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Label}"
                                           Style="{StaticResource WlMonoMetaText}"
                                           Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- The two mono labels under the bar: EACH BACKUP left, + IF YOU ADD right. -->
                    <Grid Margin="0,8,0,0">
                        <TextBlock Text="{Binding WhatGoesIn.EachBackupLabel}" Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" HorizontalAlignment="Left"
                                   AutomationProperties.Name="Each backup size" />
                        <TextBlock Text="{Binding WhatGoesIn.IfYouAddLabel}" Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" HorizontalAlignment="Right"
                                   Visibility="{Binding WhatGoesIn.IfYouAddLabel, Converter={StaticResource FreeSpaceLineVisible}}"
                                   AutomationProperties.Name="Size if plug-in files are added" />
                    </Grid>

                    <!-- The two plain-language notes in one WlBg block, hairline, 8px radius, 10px apart.
                         Lead clause strong; the rest muted. -->
                    <Border Margin="0,12,0,0" Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14">
                        <!--
                          Text="{Binding ...}" in ATTRIBUTE syntax. These four Runs previously used
                          <Run.Text>{Binding ...}</Run.Text> property-element syntax, and XAML only
                          evaluates a markup extension in an attribute - inside a property element
                          the braces are just characters. The dialog rendered the literal strings
                          "{Binding WhatGoesIn.NoteOneLead}" and "{Binding WhatGoesIn.NoteOneRest}"
                          to the user. The separating space is its own Run: a Run's leading
                          whitespace is collapsed away, so it cannot ride on the second one.

                          Mode=OneWay is NOT decoration. Run.Text is registered
                          BindsTwoWayByDefault - a Run is editable inside a RichTextBox - so a
                          plain binding to a computed, get-only model property throws
                          "A TwoWay or OneWayToSource binding cannot work on the read-only
                          property". That throw lands on the WPF thread during layout, where it
                          reads as the window never appearing rather than as an error. TextBlock's
                          own Text is already one-way, which is why nothing else here needs it.
                        -->
                        <StackPanel>
                            <TextBlock Style="{StaticResource WlSecondaryText}" TextWrapping="Wrap" LineHeight="19.575">
                                <Run FontWeight="Medium" Foreground="{DynamicResource WlStrong}"
                                     Text="{Binding WhatGoesIn.NoteOneLead, Mode=OneWay}" /><Run Text=" " /><Run
                                     Foreground="{DynamicResource WlMuted}"
                                     Text="{Binding WhatGoesIn.NoteOneRest, Mode=OneWay}" />
                            </TextBlock>
                            <TextBlock Style="{StaticResource WlSecondaryText}" TextWrapping="Wrap" LineHeight="19.575" Margin="0,10,0,0">
                                <Run FontWeight="Medium" Foreground="{DynamicResource WlStrong}"
                                     Text="{Binding WhatGoesIn.NoteTwoLead, Mode=OneWay}" /><Run Text=" " /><Run
                                     Foreground="{DynamicResource WlMuted}"
                                     Text="{Binding WhatGoesIn.NoteTwoRest, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- The unbuilt-tier footnote is GONE, with phase 6 - the same removal the
                         NOT BUILT YET badge already got in this file's own Window.Resources.
                         the settings-persistence spec's "Unbuilt tiers" section describes a state
                         this app left: both switches move now, and a line telling the user they
                         cannot was the one sentence on this screen that was untrue. -->

                    <!-- ============ WHICH WAVE LINK ============ -->
                    <!-- Hidden entirely when there is only one installation (WhichWaveLink is null):
                         with nothing to choose, the section has no reason to exist. A DataTrigger
                         cannot say "when it is NOT null show it", so the converter carries the
                         predicate - the same convention as the trash row above. -->
                    <StackPanel Visibility="{Binding WhichWaveLink, Converter={StaticResource TrashRowVisible}}">
                        <views:TrackedText Text="WHICH WAVE LINK" Tracking=".18"
                               Style="{StaticResource WlColumnHeaderTrackedText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                                   AutomationProperties.Name="Which Wave Link section" />

                        <!-- The row: version strong, path ellipsised mono, CHOSEN date mono at 80%,
                             Change… secondary on the right. -->
                        <Border Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />    <!-- version + path + chosen date -->
                                    <ColumnDefinition Width="Auto" /> <!-- Change… -->
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="{Binding WhichWaveLink.Version}"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Wave Link version" />
                                    <!-- The path is long and must not push the button; ellipsize it. -->
                                    <TextBlock Text="{Binding WhichWaveLink.Path}"
                                               Style="{StaticResource WlMonoMetaText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextTrimming="CharacterEllipsis"
                                               AutomationProperties.Name="Wave Link settings file path" />
                                    <TextBlock Text="{Binding WhichWaveLink.ChosenAtText}"
                                               Style="{StaticResource WlMonoMetaText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,2,0,0"
                                               AutomationProperties.Name="When this installation was chosen" />
                                </StackPanel>

                                <!-- Change… re-opens the error-2 chooser; App.ChangeWaveLink owns it. -->
                                <Button x:Name="ChangeWaveLinkButton" Content="Change…" Grid.Column="1"
                                        VerticalAlignment="Center" Margin="16,0"
                                        Style="{StaticResource WlSecondaryButton}"
                                        AutomationProperties.Name="Choose a different Wave Link installation" />
                            </Grid>
                        </Border>

                        <!-- The note: why this section exists at all. -->
                        <TextBlock Text="Two installations were found on this computer. This is the one being watched and restored into."
                                   Style="{StaticResource WlSecondaryText}" Foreground="{DynamicResource WlMuted}"
                                   Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="17.25"
                                   AutomationProperties.Name="Which Wave Link note" />
                    </StackPanel>

                    <!--
                      ============ WHEN WINDOWS STARTS ============
                      the tray and updates spec. Two toggles and a note.

                      RunKeyAutostart, IAutostart, AutostartState, ToggleAutostart,
                      CanEnableAutostart, AutostartBlockedNote and ClosingHidesToTray were all
                      built and tested in earlier phases, and NOTHING BOUND TO ANY OF THEM
                      (technical-debt.md §4.21 item 4). Hidden entirely when the section has no
                      seams behind it, which is what a bare test harness gets.
                    -->
                    <StackPanel Visibility="{Binding HasStartupSection, Converter={StaticResource StartupSectionVisible}}">
                        <views:TrackedText Text="WHEN WINDOWS STARTS" Tracking=".18"
                                   Style="{StaticResource WlColumnHeaderTrackedText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                                   AutomationProperties.Name="When Windows starts section" />

                        <Border Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="Start with Windows and sit in the tray"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Start with Windows label" />
                                    <TextBlock Text="Off means nothing is watched until you open the app yourself. Automatic backups only happen while it is running."
                                               Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Start with Windows description" />

                                    <!-- The design's rule: "Task Manager wins; the note says so
                                         rather than fighting it." Null note, no row. -->
                                    <TextBlock Text="{Binding StartupBlockedNote}"
                                               Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlWarn}" Margin="0,6,0,0"
                                               TextWrapping="Wrap"
                                               Visibility="{Binding StartupBlockedNote, Converter={StaticResource FreeSpaceLineVisible}}"
                                               AutomationProperties.Name="Why start with Windows cannot be turned on" />
                                </StackPanel>

                                <CheckBox x:Name="StartWithWindowsToggle" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="16,0"
                                          Style="{StaticResource WlToggle}"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                                          IsEnabled="{Binding CanStartWithWindows}"
                                          AutomationProperties.Name="Start with Windows and sit in the tray" />
                            </Grid>
                        </Border>

                        <Border Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="Closing the window hides it in the tray"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Closing hides to tray label" />
                                    <TextBlock Text="Off closes the app properly instead, and takes one last backup on the way out."
                                               Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Closing hides to tray description" />
                                </StackPanel>

                                <CheckBox x:Name="ClosingHidesToTrayToggle" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="16,0"
                                          Style="{StaticResource WlToggle}"
                                          IsChecked="{Binding ClosingHidesToTray, Mode=TwoWay}"
                                          AutomationProperties.Name="Closing the window hides it in the tray" />
                            </Grid>
                        </Border>

                        <!-- The design prints the exact Run-key line, so anyone can check it by
                             hand. Per-user, never per-machine, and never a scheduled task. -->
                        <TextBlock Text="{Binding StartupRegistryLine}"
                                   Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0"
                                   TextTrimming="CharacterEllipsis"
                                   AutomationProperties.Name="Where the startup entry is kept" />
                    </StackPanel>

                    <!--
                      ============ HOW IT LOOKS ============
                      Not in the design package: it specifies one palette per OS state and no way
                      to choose, because WlAccent following the Windows accent and the theme
                      following the Windows mode was the whole of "how it looks" until now. This
                      section is an addition, built to the package's rules rather than from one of
                      its screens - section label, WlBg row, hairline, radius 8, title in
                      WlRowNameText over a WlSecondaryText description, control on the right, and
                      it commits on change like everything else on this screen.

                      Auto is the app's own history: following Windows is what it did before there
                      was a choice, and it stays the default for anyone who never opens this.

                      Hidden when nothing was injected to drive it, the same rule WHEN WINDOWS
                      STARTS follows.
                    -->
                    <StackPanel Visibility="{Binding HasAppearanceSection, Converter={StaticResource StartupSectionVisible}}">
                        <views:TrackedText Text="HOW IT LOOKS" Tracking=".18"
                                   Style="{StaticResource WlColumnHeaderTrackedText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                                   AutomationProperties.Name="How it looks section" />

                        <Border Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="Theme"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Theme label" />
                                    <!-- Honest about the one case a person would otherwise read as
                                         a bug: Windows' own high-contrast scheme outranks whatever
                                         is picked here, because it is Windows saying the palette
                                         is no longer ours (the high-contrast spec). -->
                                    <TextBlock Text="Auto follows the light or dark setting in Windows. Turning on a high-contrast theme in Windows takes over from any choice made here."
                                               Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Theme description" />
                                </StackPanel>

                                <!-- The four segments overlap by 1px so the shared edges are one
                                     hairline rather than two, exactly as the keep-count stepper's
                                     two do a few sections up. GroupName ties them together for the
                                     keyboard even though the bindings would already agree. -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0"
                                            AutomationProperties.Name="Theme">
                                    <RadioButton x:Name="ThemeAutoSegment" GroupName="ThemeChoice"
                                                 Style="{StaticResource WlSegmentButton}"
                                                 IsChecked="{Binding ThemeIsAuto, Mode=TwoWay}"
                                                 AutomationProperties.Name="Follow Windows">
                                        <views:TrackedText Text="AUTO" Tracking=".12" />
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeDarkSegment" GroupName="ThemeChoice"
                                                 Margin="-1,0,0,0"
                                                 Style="{StaticResource WlSegmentButton}"
                                                 IsChecked="{Binding ThemeIsDark, Mode=TwoWay}"
                                                 AutomationProperties.Name="Dark">
                                        <views:TrackedText Text="DARK" Tracking=".12" />
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeLightSegment" GroupName="ThemeChoice"
                                                 Margin="-1,0,0,0"
                                                 Style="{StaticResource WlSegmentButton}"
                                                 IsChecked="{Binding ThemeIsLight, Mode=TwoWay}"
                                                 AutomationProperties.Name="Light">
                                        <views:TrackedText Text="LIGHT" Tracking=".12" />
                                    </RadioButton>
                                    <RadioButton x:Name="ThemeHighContrastSegment" GroupName="ThemeChoice"
                                                 Margin="-1,0,0,0"
                                                 Style="{StaticResource WlSegmentButton}"
                                                 IsChecked="{Binding ThemeIsHighContrast, Mode=TwoWay}"
                                                 AutomationProperties.Name="High contrast">
                                        <views:TrackedText Text="HIGH CONTRAST" Tracking=".12" />
                                    </RadioButton>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--
                      ============ UPDATES ============
                      the tray and updates spec. Three rows: the state, the available
                      update, and the weekly-check switch - plus the failed-update block.

                      It did not exist in any form, which meant error 8's "Get the update" button
                      deep-linked to a section that was never built (technical-debt.md §4.21
                      item 5).

                      Hidden entirely when no release feed is configured. A "Check now" that cannot
                      reach anything is worse than no button.
                    -->
                    <StackPanel x:Name="UpdatesSection"
                                Visibility="{Binding HasUpdatesSection, Converter={StaticResource StartupSectionVisible}}">
                        <views:TrackedText Text="UPDATES" Tracking=".18"
                                   Style="{StaticResource WlColumnHeaderTrackedText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                                   AutomationProperties.Name="Updates section" />

                        <!-- Row 1: the state and its mono line, with Check now on the right. Both
                             the up-to-date and the available-update headline live here - the row
                             does not change shape, only what it says. -->
                        <Border Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="{Binding Updates.Headline}"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Update state" />
                                    <TextBlock Text="{Binding Updates.Meta}"
                                               Style="{StaticResource WlMonoMetaText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Version and when it was last checked" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" Orientation="Horizontal"
                                            VerticalAlignment="Center" Margin="16,0">
                                    <!-- The two actions for an available update. 12 gives it a
                                         ghost "What changed" and a primary "Install and restart";
                                         both are hidden until there IS one. -->
                                    <Button x:Name="WhatChangedButton" Content="What changed"
                                            Margin="0,0,9,0"
                                            Visibility="{Binding Updates.HasUpdate, Converter={StaticResource StartupSectionVisible}}"
                                            IsEnabled="{Binding Updates.CanAct}"
                                            Style="{StaticResource WlGhostButton}"
                                            AutomationProperties.Name="What changed in this release" />

                                    <Button x:Name="InstallUpdateButton" Content="Install and restart"
                                            Margin="0,0,9,0"
                                            Visibility="{Binding Updates.HasUpdate, Converter={StaticResource StartupSectionVisible}}"
                                            IsEnabled="{Binding Updates.CanAct}"
                                            Style="{StaticResource WlPrimaryButton}"
                                            AutomationProperties.Name="Install this update and restart" />

                                    <Button x:Name="CheckForUpdatesButton" Content="Check now"
                                            IsEnabled="{Binding Updates.CanAct}"
                                            Style="{StaticResource WlSecondaryButton}"
                                            AutomationProperties.Name="Check for updates now" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--
                          The failed-update block. NEUTRAL (WlSunken), not amber, and the design is
                          explicit about why: "a failed update leaves a working app, so nothing is
                          un-whole." The lead is strong, the rest muted - the same two-part shape
                          the plain-language notes above use.
                        -->
                        <Border x:Name="UpdateFailedBlock" Margin="0,10,0,0"
                                Background="{DynamicResource WlSunken}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14"
                                Visibility="{Binding Updates.HasFailed, Converter={StaticResource StartupSectionVisible}}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource WlSecondaryText}"
                                           TextWrapping="Wrap" LineHeight="19.575">
                                    <Run FontWeight="Medium" Foreground="{DynamicResource WlStrong}"
                                         Text="{Binding Updates.FailureLead, Mode=OneWay}" /><Run Text=" " /><Run
                                         Foreground="{DynamicResource WlMuted}"
                                         Text="{Binding Updates.FailureBody, Mode=OneWay}" />
                                </TextBlock>

                                <TextBlock Text="{Binding Updates.Failure}"
                                           Style="{StaticResource WlMonoMetaText}"
                                           Foreground="{DynamicResource WlMuted}" Margin="0,8,0,0"
                                           TextWrapping="Wrap"
                                           AutomationProperties.Name="Why the update failed" />

                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                    <Button x:Name="RetryUpdateButton" Content="Try again"
                                            IsEnabled="{Binding Updates.CanAct}"
                                            Style="{StaticResource WlSecondaryButton}"
                                            AutomationProperties.Name="Try the update again" />
                                    <Button x:Name="DownloadUpdateButton" Content="Download it yourself"
                                            Margin="9,0,0,0" Style="{StaticResource WlGhostButton}"
                                            AutomationProperties.Name="Open the releases page" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Row 3: the weekly check. It only ever LOOKS - "It never installs
                             anything without you" - which is why the description says so. -->
                        <Border Margin="0,10,0,0" Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Margin="16,14">
                                    <TextBlock Text="Check for updates on its own"
                                               Style="{StaticResource WlRowNameText}"
                                               Foreground="{DynamicResource WlStrong}"
                                               AutomationProperties.Name="Automatic update check label" />
                                    <TextBlock Text="Weekly. It never installs anything without you."
                                               Style="{StaticResource WlSecondaryText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,4,0,0"
                                               TextWrapping="Wrap"
                                               AutomationProperties.Name="Automatic update check description" />
                                </StackPanel>

                                <CheckBox x:Name="AutoCheckUpdatesToggle" Grid.Column="1"
                                          VerticalAlignment="Center" Margin="16,0"
                                          Style="{StaticResource WlToggle}"
                                          IsChecked="{Binding Updates.AutoCheck, Mode=TwoWay}"
                                          AutomationProperties.Name="Check for updates on its own" />
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- ============ WHERE THESE SETTINGS LIVE ============ -->
                    <!-- Always visible: it is a fact about where the file is, not a choice. The mono
                         line carries the path and its own size; the second line keeps "a command-line
                         flag overrides this for one run" honest (the settings-persistence spec). -->
                    <views:TrackedText Text="WHERE THESE SETTINGS LIVE" Tracking=".18"
                               Style="{StaticResource WlColumnHeaderTrackedText}"
                               Foreground="{DynamicResource WlMuted}" Margin="0,22,0,10"
                               AutomationProperties.Name="Where these settings live section" />

                    <Border Background="{DynamicResource WlBg}"
                            BorderBrush="{DynamicResource WlLine}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14">
                        <StackPanel>
                            <TextBlock Style="{StaticResource WlSecondaryText}" TextWrapping="Wrap" LineHeight="19.575">
                                <Run FontWeight="Medium" Foreground="{DynamicResource WlStrong}">On this computer, for this account.</Run><Run Foreground="{DynamicResource WlMuted}"> The folder, the automatic-backup switch, how many to keep and which Wave Link you picked are kept in one small file. It travels with your Windows profile, not with your backups.</Run>
                            </TextBlock>
                            <!-- Path + own size, mono 11.5px muted. -->
                            <!-- Attribute syntax, for the reason spelt out on the notes block above:
                                 this line was rendering "{Binding WhereSettingsLive.FilePath}" as
                                 text where the path belongs. -->
                            <TextBlock Margin="0,10,0,0" Style="{StaticResource WlMonoMetaText}"
                                       Foreground="{DynamicResource WlMuted}" TextTrimming="CharacterEllipsis">
                                <Run Text="{Binding WhereSettingsLive.FilePath, Mode=OneWay}" /><Run
                                     Text=" · " /><Run Text="{Binding WhereSettingsLive.SizeText, Mode=OneWay}" />
                            </TextBlock>
                            <!--
                              "Copy diagnostics" (technical-debt.md §6, SPEC.md §11's privacy note).

                              It exists because the alternative is a user attaching their settings
                              file to a public issue, and that file carries hardware serial numbers
                              and their Windows user name. Telling people not to attach things does
                              not work; giving them something better to paste does.

                              The line beside it is a PROMISE about what the button does, and it is
                              kept by construction: Diagnostics.Report runs every field through
                              Redaction and returns a string. Nothing uploads anything, and there is
                              no setting that would make it.
                            -->
                            <Grid Margin="0,14,0,0">
                                <TextBlock Text="SERIAL NUMBERS AND YOUR USER NAME ARE REMOVED · NOTHING IS EVER UPLOADED"
                                           Style="{StaticResource WlMonoMetaText}"
                                           Foreground="{DynamicResource WlMuted}"
                                           VerticalAlignment="Center" HorizontalAlignment="Left"
                                           TextWrapping="Wrap" MaxWidth="420"
                                           AutomationProperties.Name="What copy diagnostics leaves out" />

                                <Button x:Name="CopyDiagnosticsButton" Content="{Binding CopyDiagnosticsLabel}"
                                        HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Style="{StaticResource WlSecondaryButton}"
                                        AutomationProperties.Name="Copy diagnostics to the clipboard" />
                            </Grid>

                            <!-- The flag-override line. Full opacity: the brush alone is the dim tier. -->
                            <TextBlock Text="A COMMAND-LINE FLAG OVERRIDES THIS FILE FOR THAT ONE RUN AND ISN'T SAVED"
                                       Style="{StaticResource WlMonoMetaText}" Foreground="{DynamicResource WlMuted}"
                                       Margin="0,4,0,0"
                                       AutomationProperties.Name="Command-line flag override note" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer: "CHANGES APPLY AS YOU MAKE THEM" (mono 11.5px, muted) left, Close (primary)
                 right. No Save button - every control commits immediately, so there is nothing to save. -->
            <Border Grid.Row="2" Background="{DynamicResource WlBg}"
                    BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                    Padding="24,18">
                <Grid>
                    <TextBlock Text="CHANGES APPLY AS YOU MAKE THEM" Style="{StaticResource WlMonoMetaText}"
                               Foreground="{DynamicResource WlMuted}" VerticalAlignment="Center"
                               AutomationProperties.Name="Changes apply as you make them" />
                    <Button x:Name="FooterCloseButton" Content="Close" IsCancel="True"
                            HorizontalAlignment="Right" VerticalAlignment="Center"
                            Style="{StaticResource WlPrimaryButton}"
                            AutomationProperties.Name="Close settings" />
                </Grid>
            </Border>
        </Grid>
        </Border>
    </Grid>
</Window>
