<Window x:Class="WaveLinkBackup.App.Views.SnapshotDetailsDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
         xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:views="clr-namespace:WaveLinkBackup.App.Views"
        Title="What's in this backup"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        AllowsTransparency="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        Background="Transparent">

    <!--
      What a backup HOLDS: every channel, the effect chain on each one in the order it runs, and
      the mixes with the devices they play out of.

      Not in the design package - it specifies four screens and the states they lack, and none of
      them is this one. Built to the package's rules instead of from one of its screens, and
      deliberately out of parts that already exist: the settings dialog's shape (680px card, header
      with a 30x30 close, internally scrolling body, footer), its section labels, its WlBg blocks
      and hairlines, and the row's own pill vocabulary. Nothing here is a new visual idea; the one
      new thing is the information.

      The DataContext is a SnapshotDetailsModel and every element binds to it. Nothing here reads a
      file - App does that before the window exists - so an unreadable backup arrives as a string
      to render, not as an exception to handle.
    -->

    <Window.Resources>
        <views:StringNotNullToVisibilityConverter x:Key="LineVisible" />
        <views:BoolToVisibilityConverter x:Key="WhenTrue" />
        <views:InverseBoolToVisibilityConverter x:Key="WhenFalse" />

        <!-- The board's one cell: a green checkmark where the channel feeds the mix, an empty ring
             where it does not. Shape-first (the high-contrast spec) - high contrast keeps both shapes and
             the fill is WlOk, never the only signal because the row and column names sit beside it.
             Keyed rather than inline: an inline DataTemplate with DataType=bool would match its own
             bool item and re-enter itself forever (the OOM in XamlObjectWriter). The check is the
             app's own WlCheckGeometry, stroke-rendered like every other check in this window - a
             dot read as "a cell that is filled", not as "this input goes here". -->
        <DataTemplate x:Key="WlMatrixCell">
            <Grid Width="26" Height="20">
                <!-- A fixed square, centred in the cell: an Ellipse with no size would stretch to
                     the 26x20 grid and draw an oval. Equal width and height keep it a true circle. -->
                <Ellipse Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stroke="{DynamicResource WlLine2}" StrokeThickness="1" Opacity="0.55" />
                <!-- The check's visibility comes ONLY from its style's trigger: a local
                     Visibility attribute would outrank the style and keep it collapsed forever. -->
                <Path Data="{StaticResource WlCheckGeometry}" StrokeThickness="1.8"
                      Stretch="Uniform" Width="12" Height="12">
                    <Path.Style>
                        <Style TargetType="Path">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Stroke" Value="{DynamicResource WlOk}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Path.Style>
                </Path>
            </Grid>
        </DataTemplate>

        <!-- A mix's header cell: the name, mono and tracked like every other machine line here. -->
        <DataTemplate x:Key="WlMatrixMixHeader">
            <views:TrackedText Text="{Binding}" Tracking=".08" FontSize="10"
                               Style="{StaticResource WlSlotLabelTrackedText}"
                               Foreground="{DynamicResource WlMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border Background="{DynamicResource WlScrim}" />

        <Border Width="680" MaxHeight="720" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource WlCard}"
                BorderBrush="{DynamicResource WlLine2}" BorderThickness="1" CornerRadius="8"
                Effect="{StaticResource WlDialogShadow}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />  <!-- header -->
                    <RowDefinition Height="*" />     <!-- body, scrolls -->
                    <RowDefinition Height="Auto" />  <!-- footer -->
                </Grid.RowDefinitions>

                <!-- Header: title + mono meta, and the 30x30 close the settings dialog uses. -->
                <Grid Grid.Row="0" Margin="24,22,20,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding Title}" Style="{StaticResource WlDialogTitleText}"
                                   Foreground="{DynamicResource WlStrong}" TextWrapping="Wrap"
                                   AutomationProperties.Name="Backup details title" />
                        <TextBlock Text="{Binding MetaLine}" Style="{StaticResource WlMonoMetaText}"
                                   Foreground="{DynamicResource WlMuted}" Margin="0,6,0,0"
                                   AutomationProperties.Name="When this backup was taken" />
                    </StackPanel>

                    <Button x:Name="CloseButton" Grid.Column="1" Width="30" Height="30"
                            IsCancel="True" VerticalAlignment="Top"
                            Style="{StaticResource WlIconGhostButton}"
                            AutomationProperties.Name="Close">
                        <Path Data="{StaticResource WlCloseGeometry}"
                              Stroke="{DynamicResource WlText}" StrokeThickness="1.5"
                              Width="14" Height="14" Stretch="Uniform" />
                    </Button>
                </Grid>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="0,0,4,0">
                    <StackPanel Margin="24,0,20,20">

                        <!--
                          The unreadable case. A damaged backup is worth OPENING rather than
                          refusing: "what was in it" is exactly what someone asks when a backup has
                          gone wrong, and the honest answer is the reason it cannot be read.
                        -->
                        <Border Background="{DynamicResource WlBg}"
                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                                CornerRadius="8" Padding="16,14"
                                Visibility="{Binding IsReadable, Converter={StaticResource WhenFalse}}">
                            <TextBlock Text="{Binding Unreadable}" Style="{StaticResource WlBodyText}"
                                       Foreground="{DynamicResource WlText}" TextWrapping="Wrap"
                                       AutomationProperties.Name="Why this backup cannot be described" />
                        </Border>

                        <StackPanel Visibility="{Binding IsReadable, Converter={StaticResource WhenTrue}}">

                            <!-- The row's own expansion sentence, extended. -->
                            <TextBlock Text="{Binding SummaryLine}" Style="{StaticResource WlMonoMetaText}"
                                       Foreground="{DynamicResource WlText}" TextWrapping="Wrap"
                                       AutomationProperties.Name="What this backup holds" />

                            <!-- ============ CHANNELS ============ -->
                            <views:TrackedText Text="CHANNELS" Tracking=".18"
                                               Style="{StaticResource WlColumnHeaderTrackedText}"
                                               Foreground="{DynamicResource WlMuted}" Margin="0,20,0,10"
                                               AutomationProperties.Name="Channels section" />

                            <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0,0,0,8" Background="{DynamicResource WlBg}"
                                                BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                                                CornerRadius="8" Padding="16,13">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}"
                                                                   Style="{StaticResource WlRowNameText}"
                                                                   Foreground="{DynamicResource WlStrong}"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Elgato hardware only, in the row's own
                                                             pill shape. -->
                                                        <Border Margin="9,0,0,0" VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderBrush="{DynamicResource WlLine2}"
                                                                BorderThickness="1" CornerRadius="999"
                                                                Padding="8,3"
                                                                Visibility="{Binding DeviceLabel, Converter={StaticResource LineVisible}}">
                                                            <views:TrackedText Text="{Binding DeviceLabel}"
                                                                               Tracking=".14"
                                                                               Style="{StaticResource WlTierBadgeTrackedText}"
                                                                               Foreground="{DynamicResource WlMuted}" />
                                                        </Border>

                                                        <Border Margin="6,0,0,0" VerticalAlignment="Center"
                                                                Background="Transparent"
                                                                BorderBrush="{DynamicResource WlLine2}"
                                                                BorderThickness="1" CornerRadius="999"
                                                                Padding="8,3"
                                                                Visibility="{Binding IsHidden, Converter={StaticResource WhenTrue}}">
                                                            <views:TrackedText Text="HIDDEN" Tracking=".14"
                                                                               Style="{StaticResource WlTierBadgeTrackedText}"
                                                                               Foreground="{DynamicResource WlMuted}" />
                                                        </Border>
                                                    </StackPanel>

                                                    <views:TrackedText Grid.Column="1" Text="{Binding EffectsLabel}"
                                                                       Tracking=".12"
                                                                       Style="{StaticResource WlTierBadgeTrackedText}"
                                                                       Foreground="{DynamicResource WlMuted}"
                                                                       VerticalAlignment="Center" />
                                                </Grid>

                                                <!-- Where the channel is heard. Amber only when it
                                                     is heard nowhere, which is a real state of a
                                                     real rig and the one thing nothing else in the
                                                     app would tell you. -->
                                                <views:TrackedText x:Name="Routing" Text="{Binding RoutingLine}"
                                                                   Tracking=".10" Margin="0,6,0,0"
                                                                   Style="{StaticResource WlSlotLabelTrackedText}"
                                                                   Foreground="{DynamicResource WlMuted}" />

                                                <ItemsControl ItemsSource="{Binding Effects}" Focusable="False"
                                                              Margin="0,10,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,0,0,5">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="24" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                    <ColumnDefinition Width="Auto" />
                                                                </Grid.ColumnDefinitions>

                                                                <TextBlock Grid.Column="0" Text="{Binding PositionLabel}"
                                                                           Style="{StaticResource WlMonoMetaText}"
                                                                           Foreground="{DynamicResource WlMuted}"
                                                                           VerticalAlignment="Center" />

                                                                <TextBlock x:Name="EffectName" Grid.Column="1"
                                                                           Text="{Binding Name}"
                                                                           Style="{StaticResource WlSecondaryText}"
                                                                           Foreground="{DynamicResource WlText}"
                                                                           TextTrimming="CharacterEllipsis"
                                                                           VerticalAlignment="Center" />

                                                                <Border Grid.Column="2" Margin="8,0,0,0"
                                                                        VerticalAlignment="Center"
                                                                        Background="Transparent"
                                                                        BorderBrush="{DynamicResource WlLine2}"
                                                                        BorderThickness="1" CornerRadius="4"
                                                                        Padding="6,2"
                                                                        Visibility="{Binding Bypassed, Converter={StaticResource WhenTrue}}">
                                                                    <views:TrackedText Text="BYPASSED" Tracking=".12"
                                                                                       Style="{StaticResource WlTierBadgeTrackedText}"
                                                                                       Foreground="{DynamicResource WlMuted}" />
                                                                </Border>

                                                                <views:TrackedText Grid.Column="3" Text="{Binding Meta}"
                                                                                   Tracking=".10" Margin="10,0,0,0"
                                                                                   Style="{StaticResource WlSlotLabelTrackedText}"
                                                                                   Foreground="{DynamicResource WlMuted}"
                                                                                   VerticalAlignment="Center" />
                                                            </Grid>

                                                            <DataTemplate.Triggers>
                                                                <!-- A bypassed effect is in the chain
                                                                     and doing nothing. It dims like
                                                                     every other switched-off thing in
                                                                     this app rather than gaining a
                                                                     colour of its own. -->
                                                                <DataTrigger Binding="{Binding Bypassed}" Value="True">
                                                                    <Setter TargetName="EffectName" Property="Opacity" Value="0.55" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </StackPanel>
                                        </Border>

                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsInNoMix}" Value="True">
                                                <Setter TargetName="Routing" Property="Foreground"
                                                        Value="{DynamicResource WlWarn}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ============ WHERE EACH INPUT IS HEARD ============ -->
                            <!--
                              The board: channels down the left, mixes across the top, a dot where
                              an input feeds a mix. This is Wave Link's own mixer view drawn as a
                              grid - the reference the user pointed at - and it is what variation 2b
                              trades for the row's verdict: the names leave the list and land here.

                              Two ItemsControls, one per axis, with the cells bound by INDEX into
                              each channel's MixMembership (same count and order as MixNames, which
                              the model guarantees). WPF has no nested-ItemsControl cell control, so
                              this is the honest way to lay a grid: rows are real items, columns are
                              generated per row. A channel in no mix shows all-empty cells - the
                              amber routing line above it already says what that means.
                            -->
                            <views:TrackedText Text="WHERE EACH INPUT IS HEARD" Tracking=".18"
                                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                                Foreground="{DynamicResource WlMuted}" Margin="0,20,0,10"
                                                AutomationProperties.Name="Routing matrix section" />

                            <Border Background="{DynamicResource WlBg}"
                                    BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,13">
                                <StackPanel>
                                    <!-- Header: a blank corner cell under the channel column, then one
                                         mix name per column. -->
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="150" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <ItemsControl Grid.Column="1" ItemsSource="{Binding MixNames}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                             <ItemsControl.ItemTemplate>
                                                 <DataTemplate>
                                                     <ContentControl Content="{Binding}"
                                                                     ContentTemplate="{StaticResource WlMatrixMixHeader}" />
                                                 </DataTemplate>
                                             </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <!-- One row per channel: the name, then its membership cells. -->
                                    <ItemsControl ItemsSource="{Binding Channels}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               Style="{StaticResource WlSecondaryText}"
                                                               Foreground="{DynamicResource WlStrong}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <ItemsControl Grid.Column="1" ItemsSource="{Binding MixMembership}" Focusable="False">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <UniformGrid Rows="1" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                         <ItemsControl.ItemTemplate>
                                                             <DataTemplate>
                                                                 <ContentControl Content="{Binding}"
                                                                                 ContentTemplate="{StaticResource WlMatrixCell}" />
                                                             </DataTemplate>
                                                         </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ============ MIXES AND OUTPUTS ============ -->
                            <views:TrackedText Text="MIXES AND OUTPUTS" Tracking=".18"
                                                Style="{StaticResource WlColumnHeaderTrackedText}"
                                                Foreground="{DynamicResource WlMuted}" Margin="0,14,0,10"
                                                AutomationProperties.Name="Mixes and outputs section" />

                            <Border Background="{DynamicResource WlBg}"
                                    BorderBrush="{DynamicResource WlLine}" BorderThickness="1"
                                    CornerRadius="8" Padding="16,13">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding Mixes}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,6">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="150" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                                               Style="{StaticResource WlSecondaryText}"
                                                               Foreground="{DynamicResource WlStrong}"
                                                               TextTrimming="CharacterEllipsis"
                                                               VerticalAlignment="Center" />

                                                    <Border Grid.Column="1" Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource WlLine2}"
                                                            BorderThickness="1" CornerRadius="4"
                                                            Padding="6,2"
                                                            Visibility="{Binding IsMuted, Converter={StaticResource WhenTrue}}">
                                                        <views:TrackedText Text="MUTED" Tracking=".12"
                                                                           Style="{StaticResource WlTierBadgeTrackedText}"
                                                                           Foreground="{DynamicResource WlMuted}" />
                                                    </Border>

                                                    <views:TrackedText Grid.Column="2" Text="{Binding OutputLine}"
                                                                       Tracking=".10"
                                                                       Style="{StaticResource WlSlotLabelTrackedText}"
                                                                       Foreground="{DynamicResource WlMuted}"
                                                                       VerticalAlignment="Center" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <views:TrackedText Text="{Binding MainOutputLine}" Tracking=".10"
                                                       Margin="0,6,0,0"
                                                       Style="{StaticResource WlSlotLabelTrackedText}"
                                                       Foreground="{DynamicResource WlMuted}"
                                                       Visibility="{Binding MainOutputLine, Converter={StaticResource LineVisible}}"
                                                       AutomationProperties.Name="Where Wave Link plays out" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>

                <!-- Footer: the settings dialog's shape - a fact on the left, Close on the right. -->
                <Border Grid.Row="2" Background="{DynamicResource WlBg}"
                        BorderBrush="{DynamicResource WlLine}" BorderThickness="0,1,0,0"
                        CornerRadius="0,0,8,8">
                    <Grid Margin="24,16,20,16">
                        <views:TrackedText Text="READ FROM THE BACKUP ITSELF, NOT FROM WHAT WAVE LINK HOLDS NOW"
                                           Tracking=".10" HorizontalAlignment="Left" VerticalAlignment="Center"
                                           Style="{StaticResource WlSlotLabelTrackedText}"
                                           Foreground="{DynamicResource WlMuted}" />

                        <Button x:Name="FooterCloseButton" Content="Close" IsCancel="True"
                                HorizontalAlignment="Right"
                                Style="{StaticResource WlPrimaryButton}"
                                AutomationProperties.Name="Close" />
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</Window>
