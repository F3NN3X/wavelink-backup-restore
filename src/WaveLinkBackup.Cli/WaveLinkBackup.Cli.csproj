<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>WaveLinkBackup.Cli</RootNamespace>
    <AssemblyName>wlbackup</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!--
      Framework-dependent at publish time: the .NET 10 runtime is a prerequisite, not a payload.
      The CLI ships as its own release artifact (see release.yml), so it no longer rides inside
      the app's zip — and a single-file framework-dependent exe is a few MB instead of ~70 MB
      because the runtime is resolved from the machine at startup rather than embedded.

      Stated here, not in the workflow, so a local `dotnet publish` and CI cannot disagree
      (the upstream failure mode, technical-debt.md §1.5). PublishSelfContained=false rather
      than SelfContained: the latter would apply to ordinary builds too, and a non-self-contained
      test project cannot reference a self-contained executable (NETSDK1151).
    -->
    <PublishSelfContained>false</PublishSelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../WaveLinkBackup.Core/WaveLinkBackup.Core.csproj" />
  </ItemGroup>

</Project>
