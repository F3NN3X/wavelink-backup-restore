<Project>
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <Version>0.7.0</Version>
  </PropertyGroup>

  <!--
    third_party/ holds a verbatim vendored snapshot of voltybat/WaveLinkSettingsUtility.
    It is reference material and attribution, not part of this build. Excluded here so a
    stray glob can never pull it in.
  -->
  <ItemGroup>
    <Compile Remove="third_party/**" />
    <None Remove="third_party/**" />
  </ItemGroup>
</Project>
