<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>WaveLinkBackup.Cli.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      The CLI targets win-x64 and publishes self-contained; a test project referencing it
      needs the same RID to resolve.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/WaveLinkBackup.Cli/WaveLinkBackup.Cli.csproj" />
    <ProjectReference Include="../WaveLinkBackup.Core.Tests/WaveLinkBackup.Core.Tests.csproj" />
  </ItemGroup>

</Project>
